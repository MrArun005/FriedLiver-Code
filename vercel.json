{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd extensions/friedliver-agents && npm ci --ignore-scripts && node esbuild.mjs && node scripts/web-export.mjs",
  "installCommand": "true",
  "outputDirectory": "extensions/friedliver-agents/web-dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
