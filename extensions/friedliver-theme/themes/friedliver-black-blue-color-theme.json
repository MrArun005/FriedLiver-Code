				"support.type",
				"support.class",
				"storage.type.cs",
				"storage.type.java",
				"storage.type.generic",
				"meta.type.cast.expr",
				"entity.name.type.module"
			],
			"settings": {
				"foreground": "#79dcff"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"entity.name.function.member",
				"variable.function"
			],
			"settings": {
				"foreground": "#e4ecfa"
			}
		},
		{
			"name": "Variables",
