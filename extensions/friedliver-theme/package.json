{
  "name": "friedliver-theme",
  "displayName": "FriedLiver Themes",
  "description": "The FriedLiver color themes (Design System v2: FriedLiver Dark and Light) and workbench defaults.",
  "version": "1.0.0",
  "publisher": "friedliver",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "FriedLiver Dark",
        "label": "FriedLiver Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/friedliver-dark-color-theme.json"
      },
      {
        "id": "FriedLiver Light",
        "label": "FriedLiver Light",
        "uiTheme": "vs",
        "path": "./themes/friedliver-light-color-theme.json"
      },
      {
        "id": "FriedLiver Black Blue",
        "label": "FriedLiver Black Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/friedliver-black-blue-color-theme.json"
      },
      {
        "id": "FriedLiver Light Blue",
        "label": "FriedLiver Light Blue",
        "uiTheme": "vs",
        "path": "./themes/friedliver-light-blue-color-theme.json"
      },
      {
        "id": "FriedLiver Midnight Blue",
        "label": "FriedLiver Midnight Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/friedliver-midnight-blue-color-theme.json"
      },
      {
        "id": "FriedLiver Graphite",
        "label": "FriedLiver Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/friedliver-graphite-color-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "friedliver-icons",
        "label": "FriedLiver Icons",
        "path": "./icons/friedliver-icons.json"
      }
    ],
    "iconThemes": [
      {
        "id": "friedliver-files",
        "label": "FriedLiver Files",
        "path": "./icons/friedliver-files.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "FriedLiver Dark",
      "workbench.preferredDarkColorTheme": "FriedLiver Dark",
      "workbench.preferredLightColorTheme": "FriedLiver Light",
      "workbench.productIconTheme": "friedliver-icons",
      "workbench.iconTheme": "friedliver-files",
      "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', 'Cascadia Code', Menlo, Consolas, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.55,
      "editor.fontLigatures": false,
      "terminal.integrated.fontFamily": "'Geist Mono', 'JetBrains Mono', 'Cascadia Code', Menlo, Consolas, monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.2,
      "terminal.integrated.fontLigatures.enabled": false,
      "editor.minimap.enabled": false,
      "editor.overviewRulerBorder": false,
      "editor.guides.bracketPairs": "active",
      "editor.renderLineHighlight": "line",
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.stickyScroll.enabled": true,
      "editor.padding.top": 8,
      "window.commandCenter": true,
      "workbench.tree.indent": 12,
      "workbench.list.smoothScrolling": true,
      "terminal.integrated.smoothScrolling": true,
      "workbench.fontAliasing": "antialiased",
      "workbench.layoutControl.enabled": false,
      "workbench.tips.enabled": false,
      "extensions.ignoreRecommendations": true,
      "typescript.disableAutomaticTypeAcquisition": true,
      "typescript.tsserver.useSyntaxServer": "never",
      "workbench.startupEditor": "none",
      "extensions.experimental.deferredStartupFinishedActivation": true,
      "files.watcherExclude": {
        "**/node_modules/*/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.turbo/**": true,
        "**/.parcel-cache/**": true,
        "**/.gradle/**": true
      },
      "workbench.tree.renderIndentGuides": "always",
      "workbench.list.density": "comfortable",
      "workbench.hover.delay": 500,
      "workbench.editor.tabSizing": "shrink",
      "workbench.editor.useModal": "off",
      "workbench.settings.editor": "ui",
      "workbench.settings.useSplitJSON": false,
      "workbench.welcomePage.walkthroughs.openOnInstall": false,
      "window.titleBarStyle": "custom",
      "editor.inlineSuggest.showToolbar": "never",
      "scm.diffDecorationsGutterPattern": {
        "added": false,
        "modified": true
      },
      "diffEditor.renderSideBySideInlineBreakpoint": 900,
      "diffEditor.experimental.showMoves": true,
      "workbench.experimental.modernUIEditorTabStyle": "pill"
    },
    "colors": [
      {
        "id": "friedliver.brand",
        "description": "The FriedLiver mark (title bar, welcome); never a control.",
        "defaults": {
          "dark": "#e2884f",
          "light": "#c4622a",
          "highContrast": "#e2884f",
          "highContrastLight": "#c4622a"
        }
      }
    ]
  }
}
