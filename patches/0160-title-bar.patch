diff --git a/src/vs/workbench/browser/parts/titlebar/friedliverTitle.ts b/src/vs/workbench/browser/parts/titlebar/friedliverTitle.ts
new file mode 100644
index 00000000..d9f684da
--- /dev/null
+++ b/src/vs/workbench/browser/parts/titlebar/friedliverTitle.ts
@@ -0,0 +1,129 @@
+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver: the title bar's own pieces (COMPONENTS.md §6.1, §2.33).
+ *  - The FriedLiver mark (a line drawing, 16px) after the macOS traffic lights.
+ *  - The project name at the start (the command center no longer shows it).
+ *  - The Needs-you pill: the Agents extension contributes `friedliver.needsYou.open` to the
+ *    `friedliver/titleBar` menu and sets the `friedliver.needsYouCount` context key; this renders it as
+ *    "◉ 3 need you" (bullseye + words), hidden at 0. The extension API can't draw in the title bar, so
+ *    this is the slot.
+ *--------------------------------------------------------------------------------------------*/
+
+import { $, append } from '../../../../base/browser/dom.js';
+import { BaseActionViewItem, IBaseActionViewItemOptions } from '../../../../base/browser/ui/actionbar/actionViewItems.js';
+import { IAction } from '../../../../base/common/actions.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { WindowTitle } from './windowTitle.js';
+
+export const NEEDS_YOU_COMMAND = 'friedliver.needsYou.open';
+export const NEEDS_YOU_COUNT_KEY = 'friedliver.needsYouCount';
+
+const SVG = 'http://www.w3.org/2000/svg';
+
+function svg(viewBox: string, cls: string): SVGSVGElement {
+	const el = document.createElementNS(SVG, 'svg');
+	el.setAttribute('viewBox', viewBox);
+	el.setAttribute('class', cls);
+	el.setAttribute('aria-hidden', 'true');
+	return el;
+}
+
+function path(parent: SVGElement, d: string, attrs: Record<string, string>): void {
+	const el = document.createElementNS(SVG, 'path');
+	el.setAttribute('d', d);
+	for (const [k, v] of Object.entries(attrs)) {
+		el.setAttribute(k, v);
+	}
+	parent.appendChild(el);
+}
+
+/** The FriedLiver mark as a line (spec §1.6): the liver at 16% fill, the steam stroked. Colour: friedliver.brand. */
+export function createFriedLiverMark(): HTMLElement {
+	const box = $('span.fl-title-mark');
+	const el = svg('170 60 760 700', 'fl-mark-svg');
+	path(el, 'M200 500C190 380 292 318 424 318C522 318 566 338 604 350C619 336 636 330 656 330C748 328 846 340 884 372C910 394 900 420 862 436C762 480 662 548 562 628C522 660 484 678 456 688C446 718 414 738 382 728C300 716 212 640 200 500Z', { 'fill': 'currentColor', 'fill-opacity': '.16', 'stroke': 'currentColor', 'stroke-linejoin': 'round', 'vector-effect': 'non-scaling-stroke' });
+	path(el, 'M430 270C400 230 460 200 430 160C405 128 440 104 432 84M560 285C532 245 590 215 562 175C540 145 572 122 566 102M690 300C664 266 716 240 692 206', { 'fill': 'none', 'stroke': 'currentColor', 'stroke-linecap': 'round', 'vector-effect': 'non-scaling-stroke' });
+	box.appendChild(el);
+	return box;
+}
+
+/** The project's name at the start of the title bar (13/600, --sel-fg). */
+export class FriedLiverProjectName extends Disposable {
+	constructor(container: HTMLElement, windowTitle: WindowTitle) {
+		super();
+		const label = append(container, $('span.fl-title-project'));
+		const update = () => {
+			label.textContent = windowTitle.workspaceName;
+			label.style.display = windowTitle.workspaceName ? '' : 'none';
+		};
+		update();
+		this._register(windowTitle.onDidChange(update));
+	}
+}
+
+/** The Needs-you pill (§2.33): bullseye + "3 need you"; hidden while nothing needs you. */
+export class NeedsYouActionViewItem extends BaseActionViewItem {
+
+	private countLabel: HTMLElement | undefined;
+
+	constructor(
+		action: IAction,
+		options: IBaseActionViewItemOptions,
+		@IContextKeyService private readonly contextKeyService: IContextKeyService,
+	) {
+		super(undefined, action, options);
+		const keys = new Set([NEEDS_YOU_COUNT_KEY]);
+		this._register(this.contextKeyService.onDidChangeContext(e => {
+			if (e.affectsSome(keys)) {
+				this.updateCount();
+			}
+		}));
+	}
+
+	private get count(): number {
+		const value = Number(this.contextKeyService.getContextKeyValue(NEEDS_YOU_COUNT_KEY));
+		return Number.isFinite(value) && value > 0 ? Math.floor(value) : 0;
+	}
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+		container.classList.add('fl-needs');
+		container.setAttribute('role', 'button');
+		const mark = svg('0 0 12 12', 'fl-bullseye');
+		const ring = document.createElementNS(SVG, 'circle');
+		ring.setAttribute('cx', '6');
+		ring.setAttribute('cy', '6');
+		ring.setAttribute('r', '5');
+		ring.setAttribute('fill', 'none');
+		ring.setAttribute('stroke', 'currentColor');
+		ring.setAttribute('stroke-width', '2');
+		const dot = document.createElementNS(SVG, 'circle');
+		dot.setAttribute('cx', '6');
+		dot.setAttribute('cy', '6');
+		dot.setAttribute('r', '2');
+		dot.setAttribute('fill', 'currentColor');
+		mark.append(ring, dot);
+		container.appendChild(mark);
+		this.countLabel = append(container, $('span.fl-needs-label'));
+		this.updateCount();
+	}
+
+	private updateCount(): void {
+		if (!this.element || !this.countLabel) {
+			return;
+		}
+		const n = this.count;
+		this.element.style.display = n ? '' : 'none';
+		this.countLabel.textContent = n === 1 ? localize('needsYou1', "1 needs you") : localize('needsYouN', "{0} need you", n);
+		this.element.setAttribute('aria-label', n === 1
+			? localize('needsYouAria1', "One agent needs you. Open the Agent Manager on Needs you.")
+			: localize('needsYouAriaN', "{0} agents need you. Open the Agent Manager on Needs you.", n));
+		this.updateTooltip();
+	}
+
+	protected override getTooltip(): string | undefined {
+		const n = this.count;
+		return n === 1 ? localize('needsYouTip1', "1 agent needs you: open the Agent Manager") : localize('needsYouTipN', "{0} agents need you: open the Agent Manager", n);
+	}
+}
