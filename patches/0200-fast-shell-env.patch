--- /dev/null
+++ b/src/vs/workbench/services/extensions/common/shellEnvCache.ts
@@ -0,0 +1,122 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) FriedLiver. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// FriedLiver: start the extension host with the last resolved shell environment instead of
+// waiting for `$SHELL -i -l -c` (0.3-2 s with nvm/pyenv/conda), then refresh it in the
+// background. Only an allow-list of non-secret variables is ever written to disk; the running
+// extension host then gets the full fresh environment in memory, as upstream would have given it.
+// No imports on purpose: used by the renderer and the extension host, and tested from the
+// FriedLiver repo (test/shellEnvCache.test.ts) straight out of this patch.
+
+export const SHELL_ENV_CACHE_KEY = 'friedliver.shellEnvCache';
+
+// HOME, USER, SHELL, TMPDIR come from the process itself (launchd/the desktop), so they are not cached.
+const SAFE_NAMES = new Set([
+	'PATH', 'MANPATH', 'INFOPATH', 'LANG', 'LANGUAGE',
+	'VIRTUAL_ENV', 'JAVA_HOME', 'GOPATH', 'GOROOT', 'GOBIN', 'CARGO_HOME', 'RUSTUP_HOME', 'VOLTA_HOME',
+	'BUN_INSTALL', 'PNPM_HOME', 'DENO_INSTALL', 'ANDROID_HOME', 'ANDROID_SDK_ROOT', 'SDKMAN_DIR', 'NODE_PATH',
+]);
+const SAFE_PREFIXES = ['LC_', 'NVM_', 'PYENV_', 'RBENV_', 'CONDA_', 'ASDF_', 'HOMEBREW_', 'XDG_'];
+// Wins over the allow-list: e.g. NVM_AUTH_HEADER, HOMEBREW_GITHUB_API_TOKEN.
+const SECRET = /TOKEN|KEY|SECRET|PASSWORD|PASSWD|PASS$|CREDENTIAL|AUTH|COOKIE|SESSION|PRIVATE|CERT/i;
+
+export function isSafeShellEnvName(name: string): boolean {
+	return !SECRET.test(name) && (SAFE_NAMES.has(name) || SAFE_PREFIXES.some(p => name.startsWith(p)));
+}
+
+export function pickSafeShellEnv(env: { [key: string]: string | undefined | null }): Record<string, string> {
+	const result: Record<string, string> = {};
+	for (const name of Object.keys(env)) {
+		const value = env[name];
+		if (typeof value === 'string' && isSafeShellEnvName(name)) {
+			result[name] = value;
+		}
+	}
+	return result;
+}
+
+/** The cached environment, or undefined when there is none or it is unreadable. */
+export function readShellEnvCache(get: (key: string) => string | undefined): Record<string, string> | undefined {
+	try {
+		const parsed: unknown = JSON.parse(get(SHELL_ENV_CACHE_KEY) ?? '');
+		if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+			const env = pickSafeShellEnv(parsed as Record<string, string>);
+			return env['PATH'] ? env : undefined;
+		}
+	} catch {
+		// no cache yet, or garbage
+	}
+	return undefined;
+}
+
+export function writeShellEnvCache(store: (key: string, value: string) => void, env: { [key: string]: string | undefined }): void {
+	const safe = pickSafeShellEnv(env);
+	if (safe['PATH']) {
+		store(SHELL_ENV_CACHE_KEY, JSON.stringify(safe));
+	}
+}
+
+/**
+ * What turns the environment the extension host started with into the fresh one: every changed or
+ * added variable (secrets included: they only travel in memory, to the host upstream would have
+ * given them to), and null for a cached variable the shell no longer sets.
+ */
+export function diffShellEnv(started: { [key: string]: string | undefined }, fresh: { [key: string]: string | undefined }): Record<string, string | null> {
+	const changes: Record<string, string | null> = {};
+	for (const [name, value] of Object.entries(fresh)) {
+		if (typeof value === 'string' && started[name] !== value) {
+			changes[name] = value;
+		}
+	}
+	for (const name of Object.keys(started)) {
+		if (typeof fresh[name] !== 'string') {
+			changes[name] = null;
+		}
+	}
+	return changes;
+}
+
+// Raw message on the extension host's protocol, beside Initialized/Ready/Terminate (1 byte each)
+// and RPC frames (first byte 1-12): 0xFE, 'FLSHENV', then the JSON changes.
+const MAGIC = [0xFE, 0x46, 0x4C, 0x53, 0x48, 0x45, 0x4E, 0x56];
+
+export function createShellEnvMessage(changes: Record<string, string | null>): Uint8Array {
+	const body = new TextEncoder().encode(JSON.stringify(changes));
+	const message = new Uint8Array(MAGIC.length + body.length);
+	message.set(MAGIC, 0);
+	message.set(body, MAGIC.length);
+	return message;
+}
+
+/** The changes in a shell-env message, or undefined when `message` is any other message. */
+export function parseShellEnvMessage(message: Uint8Array): Record<string, string | null> | undefined {
+	if (message.byteLength < MAGIC.length || MAGIC.some((byte, i) => message[i] !== byte)) {
+		return undefined;
+	}
+	try {
+		const parsed: unknown = JSON.parse(new TextDecoder().decode(message.subarray(MAGIC.length)));
+		const changes: Record<string, string | null> = {};
+		if (parsed && typeof parsed === 'object') {
+			for (const [name, value] of Object.entries(parsed)) {
+				if (typeof value === 'string' || value === null) {
+					changes[name] = value;
+				}
+			}
+		}
+		return changes;
+	} catch {
+		return {};
+	}
+}
+
+/** Apply changes to an environment (the extension host's `process.env`), for processes spawned from now on. */
+export function applyShellEnvChanges(env: { [key: string]: string | undefined }, changes: Record<string, string | null>): void {
+	for (const [name, value] of Object.entries(changes)) {
+		if (value === null) {
+			delete env[name];
+		} else {
+			env[name] = value;
+		}
+	}
+}
