+	/**
+	 * FriedLiver (friedliver.fastShellEnv): when the shell environment is still being resolved
+	 * (`$SHELL -i -l -c`, often 0.3-2 s), start with the last resolved one instead. Once the real one
+	 * arrives it is cached for the next launch (allow-listed variables only), and every changed
+	 * variable is sent to the extension host for the processes it spawns from then on. Terminals and tasks always wait for the real one.
+	 * First launch (no cache) and launches from the CLI (resolves at once) behave as upstream.
+	 */
+	private async _getShellEnvForExtensionHost(): Promise<platform.IProcessEnvironment> {
+		const shellEnv = this._shellEnvironmentService.getShellEnv();
+		// Only a PATH the shell changed is worth keeping: an equal one means a launch from the CLI or a
+		// failed resolution (timeout), which must not replace a good cache.
+		const save = (env: platform.IProcessEnvironment) => {
+			if (env['PATH'] !== process.env['PATH']) {
+				writeShellEnvCache((key, value) => this._storageService.store(key, value, StorageScope.APPLICATION, StorageTarget.MACHINE), env);
+			}
+		};
+		const cached = this._configurationService.getValue<boolean>('friedliver.fastShellEnv') !== false
+			? readShellEnvCache(key => this._storageService.get(key, StorageScope.APPLICATION))
+			: undefined;
+		const settled = await Promise.race([shellEnv.then(env => env, () => undefined), timeout(50).then(() => null)]);
