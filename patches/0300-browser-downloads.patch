@@ -0,0 +1,484 @@
+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0300): downloads in the browser panel (COMPONENTS.md §2.39).
+ *  - Indicator: an IconButton in the browser's actions toolbar, with a progress ring and a Count of
+ *    active downloads, shown once there is any download.
+ *  - Popover: the list (name, size, progress and speed, state) with Cancel, Retry, Open, Show in
+ *    Finder/Explorer, Copy link and Clear.
+ *  - Toasts: a finished download (Show in Finder), a failed one (Retry), and a waiting one no chat
+ *    took the OK for (Allow / Cancel): the page's (no user gesture), one from a page an agent left,
+ *    or an agent call's after 3 s. A large one asks in a dialog with its size.
+ *  - Commands the Agents extension calls (_friedliver.browser.downloads.*): agent downloads ask in
+ *    the agent's chat and report their path, size and sha256 in the tool's output.
+ *--------------------------------------------------------------------------------------------*/
+
+import '../media/browserDownloads.css';
+import { localize, localize2 } from '../../../../../nls.js';
+import { $, addDisposableListener, append, clearNode, EventType, getWindow, isAncestor } from '../../../../../base/browser/dom.js';
+import { StandardKeyboardEvent } from '../../../../../base/browser/keyboardEvent.js';
+import { Codicon } from '../../../../../base/common/codicons.js';
+import { KeyCode } from '../../../../../base/common/keyCodes.js';
+import { Disposable, DisposableStore, IDisposable, MutableDisposable, toDisposable } from '../../../../../base/common/lifecycle.js';
+import { isMacintosh, isWindows } from '../../../../../base/common/platform.js';
+import { ThemeIcon } from '../../../../../base/common/themables.js';
+import { IAction } from '../../../../../base/common/actions.js';
+import { IActionViewItem } from '../../../../../base/browser/ui/actionbar/actionbar.js';
+import { IActionViewItemOptions } from '../../../../../base/browser/ui/actionbar/actionViewItems.js';
+import { Action2, MenuId, MenuItemAction, registerAction2 } from '../../../../../platform/actions/common/actions.js';
+import { MenuEntryActionViewItem } from '../../../../../platform/actions/browser/menuEntryActionViewItem.js';
+import { IAccessibilityService } from '../../../../../platform/accessibility/common/accessibility.js';
+import { IClipboardService } from '../../../../../platform/clipboard/common/clipboardService.js';
+import { CommandsRegistry } from '../../../../../platform/commands/common/commands.js';
+import { IContextKeyService, RawContextKey } from '../../../../../platform/contextkey/common/contextkey.js';
+import { IContextMenuService, IContextViewService } from '../../../../../platform/contextview/browser/contextView.js';
+import { IDialogService } from '../../../../../platform/dialogs/common/dialogs.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../../platform/instantiation/common/instantiation.js';
+import { registerMainProcessRemoteService } from '../../../../../platform/ipc/electron-browser/services.js';
+import { IKeybindingService } from '../../../../../platform/keybinding/common/keybinding.js';
+import { INativeHostService } from '../../../../../platform/native/common/native.js';
+import { INotificationHandle, INotificationService, Severity } from '../../../../../platform/notification/common/notification.js';
+import { IThemeService } from '../../../../../platform/theme/common/themeService.js';
+import { IEditorService } from '../../../../services/editor/common/editorService.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../../common/contributions.js';
+import { IBrowserDownload, canCancelDownload, canRetryDownload, describeDownload, downloadProgress, formatBytes, ipcBrowserDownloadsChannelName, isExecutableName } from '../../../../../platform/browserView/common/browserDownloads.js';
+import { IBrowserDownloadsService } from '../../../../../platform/browserView/common/browserDownloadsService.js';
+import { BrowserActionCategory, BrowserActionGroup, BrowserEditor, BrowserEditorContribution, BROWSER_EDITOR_ACTIVE } from '../browserEditor.js';
+
+registerMainProcessRemoteService(IBrowserDownloadsService, ipcBrowserDownloadsChannelName);
+
+const CONTEXT_BROWSER_HAS_DOWNLOADS = new RawContextKey<boolean>('browserHasDownloads', false, localize('browser.hasDownloads', "Whether the integrated browser has downloaded anything in this session"));
+const SHOW_DOWNLOADS_ID = 'workbench.action.browser.showDownloads';
+/** A download an agent's call started that its chat didn't claim within this time asks in a toast instead. */
+const UNCLAIMED_AFTER_MS = 3_000;
+
+const showInFolderLabel = () => isMacintosh
+	? localize('browser.downloads.showInFinder', "Show in Finder")
+	: isWindows ? localize('browser.downloads.showInExplorer', "Show in Explorer") : localize('browser.downloads.showInFolder', "Show in Folder");
+
+function hostOf(url: string): string {
+	try {
+		return new URL(url).host || url;
+	} catch {
+		return url;
+	}
+}
+
+// #region Indicator
+
+/** The toolbar button: a download icon, a ring that fills with the active downloads' progress, and their count. */
+class DownloadsIndicatorViewItem extends MenuEntryActionViewItem {
+	private readonly _list = this._register(new MutableDisposable());
+	private _ring: SVGCircleElement | undefined;
+	private _count: HTMLElement | undefined;
+
+	constructor(
+		action: MenuItemAction,
+		options: IActionViewItemOptions,
+		private readonly _feature: BrowserDownloadsFeature,
+		@IKeybindingService keybindingService: IKeybindingService,
+		@INotificationService notificationService: INotificationService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IThemeService themeService: IThemeService,
+		@IContextMenuService contextMenuService: IContextMenuService,
+		@IAccessibilityService accessibilityService: IAccessibilityService,
+	) {
+		super(action, { hoverDelegate: options.hoverDelegate }, keybindingService, notificationService, contextKeyService, themeService, contextMenuService, accessibilityService);
+	}
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+		container.classList.add('fl-dl-indicator');
+		const ns = 'http://www.w3.org/2000/svg';
+		const svg = document.createElementNS(ns, 'svg');
+		svg.classList.add('fl-dl-indicator__ring');
+		svg.setAttribute('viewBox', '0 0 20 20');
+		svg.setAttribute('aria-hidden', 'true');
+		const track = document.createElementNS(ns, 'circle');
+		track.classList.add('fl-dl-indicator__track');
+		const ring = document.createElementNS(ns, 'circle');
+		ring.classList.add('fl-dl-indicator__fill');
+		for (const c of [track, ring]) {
+			c.setAttribute('cx', '10');
+			c.setAttribute('cy', '10');
+			c.setAttribute('r', '9');
+			c.setAttribute('pathLength', '100');
+			svg.appendChild(c);
+		}
+		this._ring = ring;
+		this._count = $('span.fl-dl-indicator__count');
+		this._count.setAttribute('aria-hidden', 'true');
+		container.append(svg, this._count);
+		this._list.value = this._feature.onDidChangeDownloads(list => this._update(list));
+		this._update(this._feature.downloads);
+		this._feature.anchor = container;
+	}
+
+	private _update(list: readonly IBrowserDownload[]): void {
+		const element = this.element;
+		if (!element || !this._ring || !this._count) {
+			return;
+		}
+		const active = list.filter(d => canCancelDownload(d.state));
+		const waiting = active.some(d => d.state === 'awaiting');
+		const sized = active.filter(d => d.totalBytes > 0);
+		const fraction = sized.length ? sized.reduce((a, d) => a + d.receivedBytes, 0) / sized.reduce((a, d) => a + d.totalBytes, 0) : undefined;
+		element.classList.toggle('fl-dl-indicator--active', active.length > 0);
+		element.classList.toggle('fl-dl-indicator--indeterminate', active.length > 0 && fraction === undefined);
+		this._ring.style.strokeDasharray = `${Math.round((fraction ?? 0.25) * 100)} 100`;
+		this._count.textContent = active.length ? String(active.length) : '';
+		this._count.classList.toggle('fl-dl-indicator__count--loud', waiting);
+		this.label?.setAttribute('aria-label', active.length
+			? localize('browser.downloads.indicatorActive', "Downloads, {0} active", active.length)
+			: localize('browser.downloads.indicator', "Downloads"));
+	}
+}
+
+// #endregion
+
+// #region Popover
+
+/** The downloads list, rendered into a context view under the indicator (Popover §2.13). */
+function renderPopover(container: HTMLElement, feature: BrowserDownloadsFeature, close: () => void): IDisposable {
+	const store = new DisposableStore();
+	const root = append(container, $('.fl-downloads'));
+	root.setAttribute('role', 'dialog');
+	root.setAttribute('aria-label', localize('browser.downloads.dialogLabel', "Downloads"));
+	const head = append(root, $('.fl-downloads__head'));
+	append(head, $('span.fl-downloads__title')).textContent = localize('browser.downloads.title', "Downloads");
+	const clear = append(head, $('button.fl-downloads__text-btn')) as HTMLButtonElement;
+	clear.textContent = localize('browser.downloads.clear', "Clear");
+	clear.title = localize('browser.downloads.clearTitle', "Remove finished downloads from the list (the files stay)");
+	store.add(addDisposableListener(clear, EventType.CLICK, () => feature.service.clear()));
+	const listEl = append(root, $('.fl-downloads__list'));
+	listEl.setAttribute('role', 'list');
+
+	const iconButton = (parent: HTMLElement, icon: ThemeIcon, label: string, run: () => unknown, cls = '') => {
+		const b = append(parent, $(`button.fl-downloads__icon-btn${cls}`)) as HTMLButtonElement;
+		b.classList.add(...ThemeIcon.asClassNameArray(icon));
+		b.setAttribute('aria-label', label);
+		b.title = label;
+		store.add(addDisposableListener(b, EventType.CLICK, e => { e.stopPropagation(); feature.run(run); }));
+		return b;
+	};
+	const textButton = (parent: HTMLElement, label: string, run: () => unknown, primary: boolean) => {
+		const b = append(parent, $(`button.fl-downloads__text-btn${primary ? '.fl-downloads__text-btn--primary' : ''}`)) as HTMLButtonElement;
+		b.textContent = label;
+		store.add(addDisposableListener(b, EventType.CLICK, e => { e.stopPropagation(); feature.run(run); }));
+		return b;
+	};
+
+	const render = (list: readonly IBrowserDownload[]) => {
+		const focused = root.ownerDocument.activeElement;
+		const refocus = focused instanceof HTMLElement && isAncestor(focused, listEl) ? focused.getAttribute('aria-label') : null;
+		clearNode(listEl);
+		clear.disabled = !list.some(d => !canCancelDownload(d.state));
+		if (!list.length) {
+			append(listEl, $('.fl-downloads__empty')).textContent = localize('browser.downloads.empty', "Files you download in the browser show here.");
+			return;
+		}
+		const s = feature.service;
+		for (const d of [...list].reverse()) {
+			const row = append(listEl, $('.fl-downloads__row'));
+			row.setAttribute('role', 'listitem');
+			row.dataset.state = d.state;
+			const icon = d.state === 'failed' ? Codicon.error : d.state === 'cancelled' ? Codicon.circleSlash : d.state === 'completed' ? Codicon.file : d.state === 'awaiting' ? Codicon.shield : Codicon.download;
+			append(row, $(`span.fl-downloads__glyph${ThemeIcon.asCSSSelector(icon)}`)).setAttribute('aria-hidden', 'true');
+			const body = append(row, $('.fl-downloads__body'));
+			const name = append(body, $('span.fl-downloads__name'));
+			name.textContent = d.filename;
+			name.title = d.path || d.filename;
+			const meta = append(body, $('span.fl-downloads__meta'));
+			meta.textContent = d.byAgent && d.state !== 'awaiting' ? `${describeDownload(d)} · ${localize('browser.downloads.byAgent', "by an agent")}` : describeDownload(d);
+			meta.title = d.url;
+			if (d.state === 'progressing') {
+				const bar = append(body, $('.fl-downloads__progress'));
+				const p = downloadProgress(d);
+				bar.setAttribute('role', 'progressbar');
+				bar.setAttribute('aria-label', localize('browser.downloads.progress', "Downloading {0}", d.filename));
+				if (p === undefined) {
+					bar.classList.add('fl-downloads__progress--indeterminate');
+				} else {
+					bar.setAttribute('aria-valuenow', String(Math.round(p * 100)));
+				}
+				append(bar, $('span.fl-downloads__progress-fill')).style.width = `${Math.round((p ?? 0.3) * 100)}%`;
+			}
+			const actions = append(row, $('.fl-downloads__actions'));
+			if (d.state === 'awaiting') {
+				textButton(actions, localize('browser.downloads.cancel', "Cancel"), () => s.approve(d.id, false), false);
+				textButton(actions, localize('browser.downloads.allow', "Download"), () => s.approve(d.id, true), true);
+				continue;
+			}
+			if (canCancelDownload(d.state)) {
+				iconButton(actions, Codicon.close, localize('browser.downloads.cancelOne', "Cancel {0}", d.filename), () => s.cancel(d.id));
+			}
+			if (canRetryDownload(d.state) && /^(https?|blob):/i.test(d.url)) {
+				iconButton(actions, Codicon.refresh, localize('browser.downloads.retry', "Retry {0}", d.filename), () => s.retry(d.id));
+			}
+			if (d.state === 'completed' && !isExecutableName(d.filename)) {
+				iconButton(actions, Codicon.goToFile, localize('browser.downloads.open', "Open {0}", d.filename), () => s.open(d.id));
+			}
+			if (d.state === 'completed') {
+				iconButton(actions, Codicon.folderOpened, showInFolderLabel(), () => s.showInFolder(d.id));
+			}
+			iconButton(actions, Codicon.link, localize('browser.downloads.copyLink', "Copy link"), () => feature.copyLink(d.url));
+		}
+		if (refocus) {
+			(listEl.querySelector(`[aria-label="${CSS.escape(refocus)}"]`) as HTMLElement | null)?.focus();
+		}
+	};
+	render(feature.downloads);
+	store.add(feature.onDidChangeDownloads(render));
+
+	// Esc closes and gives focus back; a click outside closes.
+	store.add(addDisposableListener(root, EventType.KEY_DOWN, e => {
+		if (new StandardKeyboardEvent(e).equals(KeyCode.Escape)) {
+			e.preventDefault();
+			e.stopPropagation();
+			close();
+			feature.anchor?.querySelector<HTMLElement>('.action-label')?.focus();
+		}
+	}));
+	const win = getWindow(container);
+	store.add(addDisposableListener(win, EventType.MOUSE_DOWN, e => {
+		const target = e.target as Node | null;
+		if (target && !isAncestor(target, root) && !(feature.anchor && isAncestor(target, feature.anchor))) {
+			close();
+		}
+	}, true));
+	setTimeout(() => (root.querySelector('.fl-downloads__list button, .fl-downloads__head button:not([disabled])') as HTMLElement | null)?.focus(), 0);
+	return store;
+}
+
+// #endregion
+
+// #region Per-editor feature
+
+export class BrowserDownloadsFeature extends BrowserEditorContribution {
+	/** The indicator's element in this editor's toolbar, when it is shown. */
+	anchor: HTMLElement | undefined;
+	private readonly _popover = this._register(new MutableDisposable<{ dispose(): void }>());
+
+	constructor(
+		editor: BrowserEditor,
+		@IBrowserDownloadsService readonly service: IBrowserDownloadsService,
+		@IContextViewService private readonly _contextViewService: IContextViewService,
+		@IClipboardService private readonly _clipboardService: IClipboardService,
+		@INotificationService private readonly _notificationService: INotificationService,
+	) {
+		super(editor);
+	}
+
+	get downloads(): readonly IBrowserDownload[] {
+		return BrowserDownloadsNotifier.downloads;
+	}
+
+	readonly onDidChangeDownloads = BrowserDownloadsNotifier.onDidChange;
+
+	override getActionViewItem(action: IAction, options: IActionViewItemOptions, instantiationService: IInstantiationService): IActionViewItem | undefined {
+		if (action.id === SHOW_DOWNLOADS_ID && action instanceof MenuItemAction) {
+			return instantiationService.createInstance(DownloadsIndicatorViewItem, action, options, this);
+		}
+		return undefined;
+	}
+
+	toggle(): void {
+		if (this._popover.value) {
+			this._popover.clear();
+			return;
+		}
+		const anchor = this.anchor?.isConnected ? this.anchor : undefined;
+		let open = true;
+		const view = this._contextViewService.showContextView({
+			getAnchor: () => anchor ?? { x: getWindow(undefined).innerWidth - 16, y: 64 },
+			render: container => renderPopover(container, this, () => this._popover.clear()),
+			onHide: () => {
+				open = false;
+				anchor?.classList.remove('fl-dl-indicator--open');
+				this._popover.clear();
+			},
+		});
+		anchor?.classList.add('fl-dl-indicator--open');
+		this._popover.value = { dispose: () => open && view.close() };
+	}
+
+	copyLink(url: string): void {
+		void this._clipboardService.writeText(url);
+	}
+
+	/** Runs a popover action; a refusal (Open on an installer) shows as a toast. */
+	run(action: () => unknown): void {
+		Promise.resolve().then(action).catch(err => this._notificationService.warn(err instanceof Error ? err.message : String(err)));
+	}
+
+	override dispose(): void {
+		this._popover.clear();
+		super.dispose();
+	}
+}
+
+BrowserEditor.registerContribution(BrowserDownloadsFeature);
+
+class ShowDownloadsAction extends Action2 {
+	constructor() {
+		super({
+			id: SHOW_DOWNLOADS_ID,
+			title: localize2('browser.showDownloads', "Downloads"),
+			category: BrowserActionCategory,
+			icon: Codicon.download,
+			f1: true,
+			precondition: BROWSER_EDITOR_ACTIVE,
+			menu: {
+				id: MenuId.BrowserActionsToolbar,
+				group: BrowserActionGroup.Tools,
+				order: 0,
+				when: CONTEXT_BROWSER_HAS_DOWNLOADS,
+			},
+		});
+	}
+
+	run(accessor: ServicesAccessor, browserEditor = accessor.get(IEditorService).activeEditorPane): void {
+		if (browserEditor instanceof BrowserEditor) {
+			browserEditor.getContribution(BrowserDownloadsFeature)?.toggle();
+		}
+	}
+}
+registerAction2(ShowDownloadsAction);
+
+// #endregion
+
+// #region Window-wide: list, toasts, questions, commands
+
+/** Holds the list for this window and tells the user when a download finishes, fails or needs an OK. */
+class BrowserDownloadsNotifier extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.friedliverBrowserDownloads';
+
+	static downloads: readonly IBrowserDownload[] = [];
+	private static readonly _listeners = new Set<(list: readonly IBrowserDownload[]) => void>();
+	static onDidChange(listener: (list: readonly IBrowserDownload[]) => void): IDisposable {
+		BrowserDownloadsNotifier._listeners.add(listener);
+		return toDisposable(() => BrowserDownloadsNotifier._listeners.delete(listener));
+	}
+
+	private readonly _seen = new Map<string, IBrowserDownload['state']>();
+	private readonly _asked = new Set<string>();
+	/** The open "Download it?" toasts: closed once the download is answered anywhere else. */
+	private readonly _questions = new Map<string, INotificationHandle>();
+
+	constructor(
+		@IBrowserDownloadsService private readonly _service: IBrowserDownloadsService,
+		@INotificationService private readonly _notificationService: INotificationService,
+		@IDialogService private readonly _dialogService: IDialogService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@INativeHostService private readonly _nativeHostService: INativeHostService,
+	) {
+		super();
+		const hasDownloads = CONTEXT_BROWSER_HAS_DOWNLOADS.bindTo(contextKeyService);
+		const update = (list: readonly IBrowserDownload[]) => {
+			BrowserDownloadsNotifier.downloads = list;
+			hasDownloads.set(list.length > 0);
+			for (const l of [...BrowserDownloadsNotifier._listeners]) {
+				l(list);
+			}
+			this._notify(list);
+		};
+		this._register(this._service.onDidChange(update));
+		this._service.getDownloads().then(list => {
+			for (const d of list) {
+				this._seen.set(d.id, d.state);
+			}
+			update(list);
+		}, () => { });
+	}
+
+	private _mine(d: IBrowserDownload): boolean {
+		return d.windowId === undefined || d.windowId === this._nativeHostService.windowId;
+	}
+
+	private _notify(list: readonly IBrowserDownload[]): void {
+		for (const d of list) {
+			const before = this._seen.get(d.id);
+			this._seen.set(d.id, d.state);
+			if (before === d.state || !this._mine(d)) {
+				continue;
+			}
+			if (d.state !== 'awaiting') {
+				// Closing calls onCancel, whose approve(id, false) does nothing once a download is answered.
+				this._questions.get(d.id)?.close();
+				this._questions.delete(d.id);
+			}
+			if (d.state === 'completed') {
+				this._notificationService.prompt(Severity.Info,
+					localize('browser.downloads.done', "Downloaded {0} ({1})", d.filename, formatBytes(d.receivedBytes)),
+					[{ label: showInFolderLabel(), run: () => this._service.showInFolder(d.id) }]);
+			} else if (d.state === 'failed') {
+				this._notificationService.prompt(Severity.Warning,
+					localize('browser.downloads.failed', "Couldn't download {0}: {1}", d.filename, d.error ?? localize('browser.downloads.unknown', "unknown error")),
+					canRetryDownload(d.state) && /^(https?|blob):/i.test(d.url) ? [{ label: localize('browser.downloads.retryShort', "Retry"), run: () => this._service.retry(d.id) }] : []);
+			} else if (d.state === 'awaiting' && !this._asked.has(d.id)) {
+				this._asked.add(d.id);
+				if (d.waitingFor === 'large') {
+					void this._askLarge(d);
+				} else {
+					// The page's, or one from a page an agent left: no chat will ask, so ask now.
+					setTimeout(() => void this._askUnclaimed(d.id), d.agentCall ? UNCLAIMED_AFTER_MS : 0);
+				}
+			}
+		}
+		const ids = new Set(list.map(d => d.id));
+		for (const id of [...this._seen.keys()]) {
+			if (!ids.has(id)) {
+				this._seen.delete(id);
+				this._asked.delete(id);
+				this._questions.get(id)?.close();
+				this._questions.delete(id);
+			}
+		}
+	}
+
+	private async _askLarge(d: IBrowserDownload): Promise<void> {
+		const { confirmed } = await this._dialogService.confirm({
+			type: Severity.Info,
+			message: localize('browser.downloads.largeTitle', "Download {0}?", d.filename),
+			detail: localize('browser.downloads.largeDetail', "It is {0}, from {1}. It will be saved to {2}.", formatBytes(d.totalBytes), hostOf(d.url), d.path),
+			primaryButton: localize({ key: 'browser.downloads.largeOk', comment: ['&& denotes a mnemonic'] }, "&&Download"),
+		});
+		await this._service.approve(d.id, confirmed);
+	}
+
+	/** A waiting download no chat took the OK for: ask here, so it never waits unseen. */
+	private async _askUnclaimed(id: string): Promise<void> {
+		if (!await this._service.claim(id).catch(() => false)) {
+			return;
+		}
+		const d = BrowserDownloadsNotifier.downloads.find(x => x.id === id);
+		if (!d) {
+			return;
+		}
+		const size = d.totalBytes > 0 ? ` (${formatBytes(d.totalBytes)})` : '';
+		if (d.state !== 'awaiting') {
+			return;
+		}
+		this._questions.set(id, this._notificationService.prompt(Severity.Warning,
+			d.waitingFor === 'page'
+				? localize('browser.downloads.pageAsk', "A page started a download in the browser without a click: {0}{1} from {2}. Download it?", d.filename, size, hostOf(d.url))
+				: localize('browser.downloads.agentAsk', "An agent started a download in the browser: {0}{1} from {2}. Download it?", d.filename, size, hostOf(d.url)),
+			[
+				{ label: localize('browser.downloads.allowAgent', "Download"), run: () => this._service.approve(id, true) },
+				{ label: localize('browser.downloads.cancelAgent', "Cancel"), run: () => this._service.approve(id, false) },
+			],
+			{ sticky: true, onCancel: () => this._service.approve(id, false) }));
+	}
+}
+
+registerWorkbenchContribution2(BrowserDownloadsNotifier.ID, BrowserDownloadsNotifier, WorkbenchPhase.AfterRestored);
+
+// For the Agents extension (vscode.commands.executeCommand). Results are plain JSON.
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.list', accessor => accessor.get(IBrowserDownloadsService).getDownloads());
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.beginAgentCall', accessor => accessor.get(IBrowserDownloadsService).beginAgentCall());
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.endAgentCall', (accessor, token: unknown) => typeof token === 'string' ? accessor.get(IBrowserDownloadsService).endAgentCall(token) : undefined);
+// Only with the call's token: a call never takes the OK for another call's download.
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.claim', (accessor, id: unknown, token: unknown) => typeof id === 'string' && typeof token === 'string' ? accessor.get(IBrowserDownloadsService).claim(id, token) : false);
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.approve', (accessor, id: unknown, allow: unknown) => typeof id === 'string' ? accessor.get(IBrowserDownloadsService).approve(id, allow === true) : undefined);
+CommandsRegistry.registerCommand('_friedliver.browser.downloads.waitFor', (accessor, id: unknown, ms: unknown) => typeof id === 'string' ? accessor.get(IBrowserDownloadsService).waitFor(id, typeof ms === 'number' ? ms : 0) : undefined);
+
+
+// #endregion
