+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0300): browser downloads, COMPONENTS.md §2.39.
+ *  Only design-system tokens (--fl-*, generated from tokens.css into the workbench) and theme
+ *  colours: test/browserDownloads.test.ts checks it. High contrast reads the same tokens, which
+ *  the token sheet maps to the HC theme (outlines instead of fills).
+ *--------------------------------------------------------------------------------------------*/
+
+/* ---- Indicator: IconButton sm in the browser's actions toolbar, a progress ring, a Count ---- */
+
+.monaco-workbench .fl-dl-indicator {
+	position: relative;
+}
+
+.monaco-workbench .fl-dl-indicator__ring {
+	position: absolute;
+	inset: 0;
+	margin: auto;
+	width: var(--fl-i-lg);
+	height: var(--fl-i-lg);
+	pointer-events: none;
+	transform: rotate(-90deg);
+	display: none;
+}
+
+.monaco-workbench .fl-dl-indicator--active .fl-dl-indicator__ring {
+	display: block;
+}
+
+.monaco-workbench .fl-dl-indicator__ring circle {
+	fill: none;
+	stroke-width: 2;
+}
+
+.monaco-workbench .fl-dl-indicator__track {
+	stroke: var(--fl-pill-bg);
+}
+
+.monaco-workbench .fl-dl-indicator__fill {
+	stroke: var(--fl-status-working);
+	stroke-linecap: round;
+	transition: stroke-dasharray var(--fl-dur-slow) var(--fl-ease-out);
+}
+
+.monaco-workbench .fl-dl-indicator--indeterminate .fl-dl-indicator__ring {
+	animation: fl-dl-spin calc(var(--fl-dur-hold) * 2) linear infinite;
+}
+
+/* Inside the ring the arrow drops to 12 so the ring frames it. */
+.monaco-workbench .fl-dl-indicator--active .action-label.codicon {
+	font-size: var(--fl-i-xs);
+}
+
+.monaco-workbench .fl-dl-indicator--open .action-label {
+	background-color: var(--fl-pill-active);
+}
+
+/* Count §2.6: 16 tall, pill, .75em 600 tabular; loud when a download waits for the user. */
+.monaco-workbench .fl-dl-indicator__count {
+	position: absolute;
+	top: calc(var(--fl-sp-1) * -1);
+	right: calc(var(--fl-sp-1) * -1);
+	min-width: var(--fl-h-2xs);
+	height: var(--fl-h-2xs);
+	padding: 0 var(--fl-sp-1);
+	box-sizing: border-box;
+	border-radius: var(--fl-r-pill);
+	background: var(--fl-pill-bg);
+	color: var(--fl-fg);
+	font-size: var(--fl-t-75);
+	font-weight: var(--fl-w-strong);
+	font-variant-numeric: tabular-nums;
+	line-height: var(--fl-h-2xs);
+	text-align: center;
+	pointer-events: none;
+	outline: var(--fl-line) solid var(--fl-ctl-border);
+}
+
+.monaco-workbench .fl-dl-indicator__count:empty {
+	display: none;
+}
+
+.monaco-workbench .fl-dl-indicator__count--loud {
+	background: var(--fl-decision);
+	color: var(--fl-decision-fg);
+}
+
+/* ---- Popover §2.13: glass r8, elevation 3, rows are two-line menu items ---------------------- */
+
+.monaco-workbench .fl-downloads {
+	box-sizing: border-box;
+	width: min(calc(var(--fl-sp-8) * 11.25), calc(100vw - var(--fl-sp-4)));
+	padding: var(--fl-sp-1) 0;
+	border: var(--fl-line) solid var(--fl-border);
+	border-radius: var(--fl-r-box);
+	background: var(--fl-glass-bg);
+	backdrop-filter: var(--fl-glass-blur);
+	box-shadow: var(--fl-elev-3);
+	color: var(--fl-fg);
+	font-size: var(--fl-t-100);
+	margin-top: var(--fl-sp-1);
+	animation: fl-dl-rise var(--fl-dur) var(--fl-ease-out);
+}
+
+.monaco-workbench .fl-downloads__head {
+	display: flex;
+	align-items: center;
+	gap: var(--fl-sp-2);
+	padding: var(--fl-sp-1) var(--fl-sp-2) var(--fl-sp-1) var(--fl-sp-3);
+}
+
+.monaco-workbench .fl-downloads__title {
+	flex: 1;
+	font-size: var(--fl-t-85);
+	color: var(--fl-fg-2);
+	font-weight: var(--fl-w-strong);
+}
+
+.monaco-workbench .fl-downloads__list {
+	display: flex;
+	flex-direction: column;
+	gap: var(--fl-sp-half);
+	max-height: min(60vh, calc(var(--fl-h-md) * 16));
+	overflow-y: auto;
+}
+
+.monaco-workbench .fl-downloads__empty {
+	padding: var(--fl-sp-2) var(--fl-sp-3);
+	font-size: var(--fl-t-90);
+	color: var(--fl-fg-2);
+}
+
+.monaco-workbench .fl-downloads__row {
+	display: flex;
+	align-items: center;
+	gap: var(--fl-sp-2);
+	min-height: calc(var(--fl-sp-8) + var(--fl-sp-2));
+	margin: 0 var(--fl-sp-1);
+	padding: var(--fl-sp-1) var(--fl-sp-2);
+	border-radius: var(--fl-r-row);
+}
+
+.monaco-workbench .fl-downloads__row:hover,
+.monaco-workbench .fl-downloads__row:focus-within {
+	background: var(--fl-hover-bg);
+}
+
+.monaco-workbench .fl-downloads__glyph {
+	flex: none;
+	color: var(--fl-fg-2);
+	font-size: var(--fl-i-md);
+}
+
+.monaco-workbench .fl-downloads__row[data-state='failed'] .fl-downloads__glyph,
+.monaco-workbench .fl-downloads__row[data-state='failed'] .fl-downloads__meta {
+	color: var(--fl-error);
+}
+
+.monaco-workbench .fl-downloads__row[data-state='awaiting'] .fl-downloads__glyph {
+	color: var(--fl-decision);
+}
+
+.monaco-workbench .fl-downloads__body {
+	flex: 1;
+	min-width: 0;
+	display: flex;
+	flex-direction: column;
+	gap: var(--fl-sp-half);
+}
+
+.monaco-workbench .fl-downloads__name,
+.monaco-workbench .fl-downloads__meta {
+	overflow: hidden;
+	white-space: nowrap;
+	text-overflow: ellipsis;
+	line-height: var(--fl-lh-tight);
+}
+
+.monaco-workbench .fl-downloads__row[data-state='cancelled'] .fl-downloads__name {
+	color: var(--fl-fg-2);
+}
+
+.monaco-workbench .fl-downloads__meta {
+	font-size: var(--fl-t-85);
+	color: var(--fl-fg-2);
+	font-variant-numeric: tabular-nums;
+}
+
+/* Progress §2.24: 4 tall pill track, the working colour; indeterminate slides. */
+.monaco-workbench .fl-downloads__progress {
+	position: relative;
+	height: var(--fl-sp-1);
+	border-radius: var(--fl-r-pill);
+	background: var(--fl-pill-bg);
+	overflow: hidden;
+}
+
+.monaco-workbench .fl-downloads__progress-fill {
+	position: absolute;
+	inset: 0 auto 0 0;
+	border-radius: inherit;
+	background: var(--fl-status-working);
+	transition: width var(--fl-dur-slow) var(--fl-ease-out);
+}
+
+.monaco-workbench .fl-downloads__progress--indeterminate .fl-downloads__progress-fill {
+	animation: fl-dl-slide calc(var(--fl-dur-hold) * 2) linear infinite;
+}
+
+.monaco-workbench .fl-downloads__actions {
+	flex: none;
+	display: flex;
+	align-items: center;
+	gap: var(--fl-sp-half);
+}
+
+/* IconButton sm, muted: 22 square, r5, 14 icon, fg-2 → fg on the ghost fill. */
+.monaco-workbench .fl-downloads__icon-btn {
+	display: inline-flex;
+	align-items: center;
+	justify-content: center;
+	width: var(--fl-h-sm);
+	height: var(--fl-h-sm);
+	padding: 0;
+	border: var(--fl-line) solid var(--fl-ctl-border);
+	border-radius: var(--fl-r-ctl);
+	background: transparent;
+	color: var(--fl-fg-2);
+	font-size: var(--fl-i-sm);
+	cursor: pointer;
+}
+
+/* Button sm: 22 tall, min 44, padding 0 8, r5, .9em; quiet, or the one primary (inverted neutral). */
+.monaco-workbench .fl-downloads__text-btn {
+	height: var(--fl-h-sm);
+	min-width: calc(var(--fl-h-sm) * 2);
+	padding: 0 var(--fl-sp-2);
+	border: var(--fl-line) solid var(--fl-ctl-border);
+	border-radius: var(--fl-r-ctl);
+	background: transparent;
+	color: var(--fl-fg-2);
+	font: inherit;
+	font-size: var(--fl-t-90);
+	line-height: 1;
+	white-space: nowrap;
+	cursor: pointer;
+}
+
+.monaco-workbench .fl-downloads__icon-btn:hover,
+.monaco-workbench .fl-downloads__text-btn:hover:not(:disabled) {
+	background: var(--fl-ghost-hover);
+	color: var(--fl-fg);
+}
+
+.monaco-workbench .fl-downloads__icon-btn:active,
+.monaco-workbench .fl-downloads__text-btn:active:not(:disabled) {
+	background: var(--fl-pill-active);
+}
+
+.monaco-workbench .fl-downloads__text-btn--primary {
+	background: var(--fl-primary-bg);
+	color: var(--fl-primary-fg);
+	font-weight: var(--fl-w-medium);
+}
+
+.monaco-workbench .fl-downloads__text-btn--primary:hover:not(:disabled) {
+	background: color-mix(in srgb, var(--fl-primary-bg) 88%, var(--fl-primary-fg));
+	color: var(--fl-primary-fg);
+}
+
+.monaco-workbench .fl-downloads__text-btn:disabled {
+	opacity: 0.4;
+	cursor: default;
+}
+
+.monaco-workbench .fl-downloads__icon-btn:focus-visible,
+.monaco-workbench .fl-downloads__text-btn:focus-visible {
+	outline: var(--fl-focus-w) solid var(--fl-focus);
+	outline-offset: var(--fl-focus-off);
+}
+
+@keyframes fl-dl-rise {
+	from {
+		opacity: 0;
+		transform: translateY(var(--fl-rise));
+	}
+}
+
+@keyframes fl-dl-spin {
+	to {
+		transform: rotate(270deg);
+	}
+}
+
+@keyframes fl-dl-slide {
+	from {
+		left: -30%;
+	}
+	to {
+		left: 100%;
+	}
+}
+
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench .fl-downloads,
+	.monaco-workbench .fl-dl-indicator__ring,
+	.monaco-workbench .fl-downloads__progress-fill {
+		animation: none;
+		transition: none;
+	}
+}
