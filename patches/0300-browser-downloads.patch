+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0300): the integrated browser's downloads, owned by the main process
+ *  (BrowserDownloadsMainService) and read by every window over the browserDownloads channel.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Event } from '../../../base/common/event.js';
+import { createDecorator } from '../../instantiation/common/instantiation.js';
+import { IBrowserDownload } from './browserDownloads.js';
+
+export const IBrowserDownloadsService = createDecorator<IBrowserDownloadsService>('browserDownloadsService');
+
+export interface IBrowserDownloadsService {
+	readonly _serviceBrand: undefined;
+
+	/** The whole list, oldest first, whenever anything in it changes (progress at most 4 times a second). */
+	readonly onDidChange: Event<readonly IBrowserDownload[]>;
+
+	getDownloads(): Promise<IBrowserDownload[]>;
+
+	/** Answers a download that waits for the user's OK: resume it, or cancel it before a byte is kept. */
+	approve(id: string, allow: boolean): Promise<void>;
+	cancel(id: string): Promise<void>;
+	/** Downloads a cancelled or failed one again from its URL; the old row goes. */
+	retry(id: string): Promise<void>;
+	/** Opens a finished file with its default app. Refused for apps, installers and scripts (isExecutableName). */
+	open(id: string): Promise<void>;
+	showInFolder(id: string): Promise<void>;
+	/** Removes every finished row; files stay on disk. */
+	clear(): Promise<void>;
+
+	/**
+	 * An agent's browser call starts. Downloads that start before it ends are this call's (agentCall,
+	 * the newest call's when several act) and wait for the user's OK (waitingFor 'agent'). Returns the token for endAgentCall and claim.
+	 */
+	beginAgentCall(): Promise<string>;
+	/** That call ended; other calls keep acting. Pages stay the agent's until the user interacts with them (DownloadAttribution). */
+	endAgentCall(token: string): Promise<void>;
+	/** Takes the OK for a waiting download; with `agentCall`, only that call's own. False when it was taken already. */
+	claim(id: string, agentCall?: string): Promise<boolean>;
+	/** Resolves when the download is finished, or with its state after `timeoutMs`. */
+	waitFor(id: string, timeoutMs: number): Promise<IBrowserDownload | undefined>;
+}
diff --git a/src/vs/platform/browserView/electron-main/browserDownloadsMainService.ts b/src/vs/platform/browserView/electron-main/browserDownloadsMainService.ts
