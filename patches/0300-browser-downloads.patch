index 00000000..5c7f3fb8
--- /dev/null
+++ b/src/vs/platform/browserView/electron-main/browserDownloadsMainService.ts
@@ -0,0 +1,462 @@
+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0300): saves what the integrated browser downloads.
+ *
+ *  - Into friedliver.browser.downloadFolder (user settings; default ~/Downloads) under a sanitized,
+ *    unique name, or where the user picks when friedliver.browser.downloadAsk is on.
+ *  - Only http(s) sources (and blobs web pages make); everything else is refused before a byte is written.
+ *  - A download an agent or the page started (no user gesture, or a page an agent acted on since the
+ *    user last did), or one over 500 MB, is paused until the user allows it. It is written to a
+ *    staging folder (Chromium may already put its first chunk on disk while it is paused:
+ *    scripts/downloads-probe.cjs) and moved into the downloads folder only once it is finished.
+ *  - Downloads that start during an agent's browser call are that call's alone (DownloadAttribution).
+ *  - Nothing is ever opened or run automatically. Finished files keep (or get) the OS's
+ *    downloaded-from-the-internet mark: com.apple.quarantine on macOS, Zone.Identifier on Windows.
+ *--------------------------------------------------------------------------------------------*/
+
+import { app, shell, webContents as allWebContents } from 'electron';
+import { createHash } from 'crypto';
+import { execFile } from 'child_process';
+import * as fs from 'fs';
+import { homedir } from 'os';
+import { basename, dirname, join } from '../../../base/common/path.js';
+import { Emitter } from '../../../base/common/event.js';
+import { Disposable, toDisposable } from '../../../base/common/lifecycle.js';
+import { RunOnceScheduler } from '../../../base/common/async.js';
+import { generateUuid } from '../../../base/common/uuid.js';
+import { isMacintosh, isWindows } from '../../../base/common/platform.js';
+import { createDecorator } from '../../instantiation/common/instantiation.js';
+import { IConfigurationService } from '../../configuration/common/configuration.js';
+import { ILogService } from '../../log/common/log.js';
+import { IBrowserDownload, BrowserDownloadEvent, DownloadAttribution, canCancelDownload, canRetryDownload, expandHome, formatBytes, isAllowedDownloadUrl, isDownloadFinished, isExecutableName, needsSizeConfirm, nextDownloadState, pruneDownloads, sanitizeFilename, uniqueFilename } from '../common/browserDownloads.js';
+import { IBrowserDownloadsService } from '../common/browserDownloadsService.js';
+import { BrowserSession } from './browserSession.js';
+import { IBrowserViewMainService } from './browserViewMainService.js';
+
+export const IBrowserDownloadsMainService = createDecorator<IBrowserDownloadsMainService>('browserDownloadsMainService');
+export interface IBrowserDownloadsMainService extends IBrowserDownloadsService { }
+
+/** How soon after Retry its download must start to count as the user's. */
+const RETRY_WINDOW_MS = 10_000;
+
+type Mutable<T> = { -readonly [K in keyof T]: T[K] };
+
+interface Entry {
+	d: Mutable<IBrowserDownload>;
+	item?: Electron.DownloadItem;
+	session?: Electron.Session;
+	claimed: boolean;
+	waiters: (() => void)[];
+	/** Where a download that waited is written until it is finished and moved to d.path. */
+	staged?: string;
+}
+
+export class BrowserDownloadsMainService extends Disposable implements IBrowserDownloadsMainService {
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _onDidChange = this._register(new Emitter<readonly IBrowserDownload[]>());
+	readonly onDidChange = this._onDidChange.event;
+
+	private readonly entries = new Map<string, Entry>();
+	/** Paths handed to downloads still writing, so two at once never get the same name. */
+	private readonly reserved = new Set<string>();
+	private readonly attribution = new DownloadAttribution<Electron.WebContents>();
+	/** URLs the user asked to download again (Retry), and when: the download that follows within seconds is the user's. */
+	private readonly retried = new Map<string, number>();
+	private readonly progress = this._register(new RunOnceScheduler(() => this.fire(), 250));
+
+	constructor(
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@ILogService private readonly logService: ILogService,
+		@IBrowserViewMainService private readonly browserViewMainService: IBrowserViewMainService,
+	) {
+		super();
+		this._register(BrowserSession.onWillDownload(e => this.willDownload(e.event, e.item, e.webContents, e.session)));
+		// The user's input in a browser view's page (not the workbench's), to tell their downloads from the page's.
+		const watch = (contents: Electron.WebContents) => {
+			if (BrowserSession.isBrowserViewWebContents(contents)) {
+				contents.on('input-event', (_e, input) => this.attribution.userInput(contents, input.type));
+			}
+		};
+		allWebContents.getAllWebContents().forEach(watch);
+		const onCreated = (_e: Electron.Event, contents: Electron.WebContents) => watch(contents);
+		app.on('web-contents-created', onCreated);
+		this._register(toDisposable(() => app.off('web-contents-created', onCreated)));
+	}
+
+	// #region Electron
+
+	private willDownload(event: Electron.Event, item: Electron.DownloadItem, webContents: Electron.WebContents, session: Electron.Session): void {
+		const chain = item.getURLChain();
+		const url = chain.at(-1) ?? item.getURL();
+		const name = sanitizeFilename(item.getFilename());
+		const retriedAt = this.retried.get(chain[0] ?? url);
+		this.retried.delete(chain[0] ?? url);
+		const who: ReturnType<DownloadAttribution['classify']> = retriedAt !== undefined && Date.now() - retriedAt < RETRY_WINDOW_MS ? { byAgent: false } : this.attribution.classify(webContents, item.hasUserGesture());
+		const base: Mutable<IBrowserDownload> = {
+			id: generateUuid(),
+			url,
+			filename: name,
+			path: '',
+			state: 'progressing',
+			byAgent: who.byAgent,
+			agentCall: who.agentCall,
+			receivedBytes: 0,
+			totalBytes: Math.max(0, item.getTotalBytes()),
+			bytesPerSecond: 0,
+			startTime: Date.now(),
+			windowId: safe(() => this.browserViewMainService.windowIdForWebContents(webContents)),
+		};
+		const entry: Entry = { d: base, session, claimed: false, waiters: [] };
+
+		if (!(chain.length ? chain : [url]).every(isAllowedDownloadUrl)) {
+			event.preventDefault();
+			this.add(entry);
+			this.transition(entry, 'fail', 'Only http and https downloads are allowed');
+			return;
+		}
+
+		const folder = this.folder();
+		const ask = !who.waitingFor && this.configurationService.getValue<boolean>('friedliver.browser.downloadAsk') === true;
+		try {
+			fs.mkdirSync(folder, { recursive: true });
+		} catch (err) {
+			if (!ask) {
+				event.preventDefault();
+				this.add(entry);
+				this.transition(entry, 'fail', `Can't write to ${folder}`);
+				this.logService.error(`[browser downloads] ${folder}: ${err}`);
+				return;
+			}
+		}
+		// An agent's or the page's download, or a large one, goes no further until the user allows it.
+		const wait = who.waitingFor ?? (!ask && needsSizeConfirm(base.totalBytes) ? 'large' : undefined);
+		const file = join(folder, uniqueFilename(name, candidate => this.taken(join(folder, candidate))));
+		if (wait) {
+			const staging = join(app.getPath('userData'), 'BrowserDownloadsPending');
+			try {
+				fs.mkdirSync(staging, { recursive: true });
+			} catch (err) {
+				event.preventDefault();
+				this.add(entry);
+				this.transition(entry, 'fail', `Can't write to ${staging}`);
+				this.logService.error(`[browser downloads] ${staging}: ${err}`);
+				return;
+			}
+			entry.staged = join(staging, base.id);
+		}
+		this.reserved.add(file.toLowerCase());
+		entry.item = item;
+		if (entry.staged) {
+			item.setSavePath(entry.staged);
+			base.path = file;
+			base.filename = basename(file);
+		} else if (ask) {
+			// Electron shows its Save dialog after this handler returns; the size goes in its title.
+			const size = base.totalBytes > 0 ? ` (${formatBytes(base.totalBytes)})` : '';
+			item.setSaveDialogOptions({ title: `Save ${basename(file)}${size}`, message: `Save ${basename(file)}${size} from ${hostOf(url)}`, defaultPath: file });
+		} else {
+			item.setSavePath(file);
+			base.path = file;
+			base.filename = basename(file);
+		}
+
+		if (wait) {
+			item.pause();
+			base.state = 'awaiting';
+			base.waitingFor = wait;
+		}
+
+		item.on('updated', () => {
+			if (entry.d.state !== 'progressing') {
+				return;
+			}
+			this.measure(entry);
+			this.progress.schedule();
+		});
+		item.once('done', (_e, state) => {
+			this.measure(entry);
+			if (state === 'completed') {
+				// The name stays reserved until a staged file has been moved there.
+				void this.finish(entry).finally(() => this.reserved.delete(file.toLowerCase()));
+			} else {
+				this.reserved.delete(file.toLowerCase());
+				if (entry.staged) {
+					void fs.promises.rm(entry.staged, { force: true }).catch(() => { });
+				}
+				this.transition(entry, state === 'cancelled' ? 'cancel' : 'fail', state === 'interrupted' ? 'Interrupted (network or disk error)' : undefined);
+			}
+		});
+		this.add(entry);
+	}
+
+	private measure(entry: Entry): void {
+		const item = entry.item;
+		if (!item) {
+			return;
+		}
+		entry.d.receivedBytes = item.getReceivedBytes();
+		entry.d.totalBytes = Math.max(0, item.getTotalBytes());
+		entry.d.bytesPerSecond = Math.max(0, item.getCurrentBytesPerSecond());
+		const chosen = item.getSavePath();
+		if (!entry.staged && chosen && chosen !== entry.d.path) {
+			entry.d.path = chosen;
+			entry.d.filename = basename(chosen);
+		}
+	}
+
+	private async finish(entry: Entry): Promise<void> {
+		const file = entry.d.path;
+		try {
+			if (entry.staged) {
+				await moveNoOverwrite(entry.staged, file);
+			}
+			await markFromInternet(file, entry.d.url);
+			entry.d.receivedBytes = (await fs.promises.stat(file)).size;
+			entry.d.sha256 = await sha256(file);
+			this.transition(entry, 'complete');
+		} catch (err) {
+			this.logService.error(`[browser downloads] ${file}: ${err}`);
+			this.transition(entry, 'fail', `Saved, but could not check the file: ${err instanceof Error ? err.message : String(err)}`);
+		}
+	}
+
+	// #endregion
+
+	// #region State
+
+	private add(entry: Entry): void {
+		this.entries.set(entry.d.id, entry);
+		const kept = pruneDownloads([...this.entries.values()].map(e => e.d));
+		if (kept.length !== this.entries.size) {
+			const ids = new Set(kept.map(d => d.id));
+			for (const id of [...this.entries.keys()]) {
+				if (!ids.has(id)) {
+					this.entries.delete(id);
+				}
+			}
+		}
+		this.fire();
+	}
+
+	private transition(entry: Entry, event: BrowserDownloadEvent, error?: string): void {
+		const next = nextDownloadState(entry.d.state, event);
+		if (!next) {
+			return;
+		}
+		entry.d.state = next;
+		if (next !== 'awaiting') {
+			entry.d.waitingFor = undefined;
+		}
+		if (isDownloadFinished(next)) {
+			entry.d.endTime = Date.now();
+			entry.d.bytesPerSecond = 0;
+			entry.item = undefined;
+			if (error) {
+				entry.d.error = error;
+			}
+			for (const w of entry.waiters.splice(0)) {
+				w();
+			}
+		}
+		this.fire();
+	}
+
+	private fire(): void {
+		this.progress.cancel();
+		this._onDidChange.fire(this.list());
+	}
+
+	private list(): IBrowserDownload[] {
+		return [...this.entries.values()].map(e => ({ ...e.d }));
+	}
+
+	private folder(): string {
+		const setting = this.configurationService.getValue<string>('friedliver.browser.downloadFolder');
+		const raw = typeof setting === 'string' && setting.trim() ? setting.trim() : app.getPath('downloads');
+		return expandHome(raw, homedir());
+	}
+
+	private taken(path: string): boolean {
+		return this.reserved.has(path.toLowerCase()) || fs.existsSync(path) || fs.existsSync(`${path}.crdownload`);
+	}
+
+	private entry(id: string): Entry {
+		const entry = this.entries.get(id);
+		if (!entry) {
+			throw new Error(`No download ${id}`);
+		}
+		return entry;
+	}
+
+	// #endregion
+
+	// #region IBrowserDownloadsService
+
+	async getDownloads(): Promise<IBrowserDownload[]> {
+		return this.list();
+	}
+
+	async approve(id: string, allow: boolean): Promise<void> {
+		const entry = this.entry(id);
+		if (entry.d.state !== 'awaiting' || !entry.item) {
+			return;
+		}
+		if (!allow) {
+			entry.item.cancel();
+			this.transition(entry, 'cancel');
+			return;
+		}
+		this.transition(entry, 'approve');
+		entry.item.resume();
+	}
+
+	async cancel(id: string): Promise<void> {
+		const entry = this.entry(id);
+		if (!canCancelDownload(entry.d.state)) {
+			return;
+		}
+		entry.item?.cancel();
+		this.transition(entry, 'cancel');
+	}
+
+	async retry(id: string): Promise<void> {
+		const entry = this.entry(id);
+		if (!canRetryDownload(entry.d.state) || !entry.session || !isAllowedDownloadUrl(entry.d.url)) {
+			return;
+		}
+		this.entries.delete(id);
+		this.fire();
+		this.retried.set(entry.d.url, Date.now());
+		entry.session.downloadURL(entry.d.url);
+	}
+
+	async open(id: string): Promise<void> {
+		const entry = this.entry(id);
+		if (entry.d.state !== 'completed' || !entry.d.path) {
+			return;
+		}
+		if (isExecutableName(entry.d.filename)) {
+			throw new Error(`${entry.d.filename} could run a program, so FriedLiver doesn't open it. Show it in the folder and open it yourself if you trust it.`);
+		}
+		const error = await shell.openPath(entry.d.path);
+		if (error) {
+			throw new Error(error);
+		}
+	}
+
+	async showInFolder(id: string): Promise<void> {
+		const entry = this.entry(id);
+		if (entry.d.path && fs.existsSync(entry.d.path)) {
+			shell.showItemInFolder(entry.d.path);
+		} else if (entry.d.path) {
+			await shell.openPath(dirname(entry.d.path));
+		}
+	}
+
+	async clear(): Promise<void> {
+		for (const [id, entry] of [...this.entries]) {
+			if (isDownloadFinished(entry.d.state)) {
+				this.entries.delete(id);
+			}
+		}
+		this.fire();
+	}
+
+	async beginAgentCall(): Promise<string> {
+		return this.attribution.begin();
+	}
+
+	async endAgentCall(token: string): Promise<void> {
+		this.attribution.end(token);
+	}
+
+	async claim(id: string, agentCall?: string): Promise<boolean> {
+		const entry = this.entry(id);
+		if (entry.claimed || entry.d.state !== 'awaiting' || (agentCall !== undefined && entry.d.agentCall !== agentCall)) {
+			return false;
+		}
+		entry.claimed = true;
+		return true;
+	}
+
+	async waitFor(id: string, timeoutMs: number): Promise<IBrowserDownload | undefined> {
+		const entry = this.entries.get(id);
+		if (!entry) {
+			return undefined;
+		}
+		if (!isDownloadFinished(entry.d.state)) {
+			await new Promise<void>(resolve => {
+				const timer = setTimeout(done, Math.max(0, Math.min(timeoutMs, 30 * 60_000)));
+				function done() {
+					clearTimeout(timer);
+					resolve();
+				}
+				entry.waiters.push(done);
+			});
+		}
+		return { ...entry.d };
+	}
+
+	// #endregion
+}
+
+function safe<T>(f: () => T): T | undefined {
+	try {
+		return f();
+	} catch {
+		return undefined;
+	}
+}
+
+function hostOf(url: string): string {
+	try {
+		return new URL(url).host || url;
+	} catch {
+		return url;
+	}
+}
+
+function sha256(file: string): Promise<string> {
+	return new Promise((resolve, reject) => {
+		const hash = createHash('sha256');
+		fs.createReadStream(file).on('error', reject).on('data', chunk => hash.update(chunk)).on('end', () => resolve(hash.digest('hex')));
+	});
+}
+
+/** Moves a finished staged download into place, never over an existing file (a hard link, or an exclusive copy across volumes). */
+async function moveNoOverwrite(from: string, to: string): Promise<void> {
+	try {
+		await fs.promises.link(from, to);
+	} catch (err) {
+		if ((err as NodeJS.ErrnoException).code === 'EEXIST') {
+			throw new Error(`${basename(to)} appeared in the folder meanwhile; the download was not saved over it`);
+		}
+		await fs.promises.copyFile(from, to, fs.constants.COPYFILE_EXCL);
+	}
+	await fs.promises.rm(from, { force: true });
+}
+
+function run(cmd: string, args: string[]): Promise<boolean> {
+	return new Promise(resolve => execFile(cmd, args, { timeout: 10_000 }, err => resolve(!err)));
+}
+
+/**
+ * Keeps the OS's "downloaded from the internet" mark on the file, adding it when Chromium didn't:
+ * Gatekeeper and SmartScreen then check the file before it first runs. Never removes it.
+ */
+async function markFromInternet(file: string, url: string): Promise<void> {
+	if (isMacintosh) {
+		if (await run('/usr/bin/xattr', ['-p', 'com.apple.quarantine', file])) {
+			return;
+		}
+		const value = `0081;${Math.floor(Date.now() / 1000).toString(16)};FriedLiver;${generateUuid().toUpperCase()}`;
+		if (!await run('/usr/bin/xattr', ['-w', 'com.apple.quarantine', value, file])) {
+			throw new Error('could not mark it as downloaded (com.apple.quarantine)');
+		}
+	} else if (isWindows) {
+		const stream = `${file}:Zone.Identifier`;
+		if (!fs.existsSync(stream)) {
+			await fs.promises.writeFile(stream, `[ZoneTransfer]\r\nZoneId=3\r\nHostUrl=${url.startsWith('blob:') ? 'about:internet' : url}\r\n`);
+		}
+	}
+}
