diff --git a/src/vs/platform/browserView/common/browserDownloads.ts b/src/vs/platform/browserView/common/browserDownloads.ts
new file mode 100644
index 00000000..78b8bb84
--- /dev/null
+++ b/src/vs/platform/browserView/common/browserDownloads.ts
@@ -0,0 +1,335 @@
+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0300): downloads in the integrated browser.
+ *  The rules, with no imports so FriedLiver's own tests run them as they ship:
+ *  the file name a download gets, the name that doesn't overwrite, which sources may download,
+ *  which files are never opened from the downloads list, and the state machine.
+ *--------------------------------------------------------------------------------------------*/
+
+export const ipcBrowserDownloadsChannelName = 'browserDownloads';
+
+/** Above this a download waits for the user's OK, with its size shown (500 MB). */
+export const LARGE_DOWNLOAD_BYTES = 500 * 1024 * 1024;
+
+/** How many finished downloads the list keeps. */
+export const MAX_DOWNLOADS_KEPT = 50;
+
+/**
+ * awaiting: paused before any byte is written, until the user allows it (an agent or the page started it, or it is large).
+ * progressing: being written. completed / cancelled / failed: finished.
+ */
+export type BrowserDownloadState = 'awaiting' | 'progressing' | 'completed' | 'cancelled' | 'failed';
+
+/**
+ * Why an `awaiting` download waits: an agent's call started it, or it came from a page an agent acted
+ * on since the user last did (agent); it started without a user gesture (page); it is over 500 MB (large).
+ */
+export type BrowserDownloadWait = 'agent' | 'page' | 'large';
+
+export type BrowserDownloadEvent = 'approve' | 'cancel' | 'complete' | 'fail';
+
+export interface IBrowserDownload {
+	readonly id: string;
+	/** Where the bytes come from (the last URL after redirects). */
+	readonly url: string;
+	/** The file's name on disk: sanitized and unique in its folder. */
+	readonly filename: string;
+	/** The full path; empty until the user picks it when FriedLiver asks where to save. */
+	readonly path: string;
+	readonly state: BrowserDownloadState;
+	readonly waitingFor?: BrowserDownloadWait;
+	/** Started while an agent was acting in the browser, or on a page an agent acted on since the user last did. */
+	readonly byAgent: boolean;
+	/** The agent call (DownloadAttribution.begin) it started during: only that call may take the OK in its chat. */
+	readonly agentCall?: string;
+	readonly receivedBytes: number;
+	/** 0 when the server didn't say. */
+	readonly totalBytes: number;
+	readonly bytesPerSecond: number;
+	readonly startTime: number;
+	readonly endTime?: number;
+	readonly error?: string;
+	/** Hex SHA-256 of the finished file. */
+	readonly sha256?: string;
+	/** The window whose browser started it, when known. */
+	readonly windowId?: number;
+}
+
+const TRANSITIONS: Record<BrowserDownloadState, Partial<Record<BrowserDownloadEvent, BrowserDownloadState>>> = {
+	awaiting: { approve: 'progressing', cancel: 'cancelled', fail: 'failed' },
+	progressing: { cancel: 'cancelled', complete: 'completed', fail: 'failed' },
+	completed: {},
+	cancelled: {},
+	failed: {},
+};
+
+/** The state after `event`, or undefined when the event doesn't apply (a finished download stays finished). */
+export function nextDownloadState(state: BrowserDownloadState, event: BrowserDownloadEvent): BrowserDownloadState | undefined {
+	return TRANSITIONS[state][event];
+}
+
+export function isDownloadFinished(state: BrowserDownloadState): boolean {
+	return state === 'completed' || state === 'cancelled' || state === 'failed';
+}
+
+export function canRetryDownload(state: BrowserDownloadState): boolean {
+	return state === 'cancelled' || state === 'failed';
+}
+
+export function canCancelDownload(state: BrowserDownloadState): boolean {
+	return state === 'awaiting' || state === 'progressing';
+}
+
+/** Whether a large download asks first: only when the server said how big it is. */
+export function needsSizeConfirm(totalBytes: number): boolean {
+	return totalBytes > LARGE_DOWNLOAD_BYTES;
+}
+
+/** Only web pages download: http and https, or a blob a web page made. Never file:, data: or anything else. */
+export function isAllowedDownloadUrl(url: string): boolean {
+	let u: URL;
+	try {
+		u = new URL(url);
+	} catch {
+		return false;
+	}
+	if (u.protocol === 'http:' || u.protocol === 'https:') {
+		return true;
+	}
+	if (u.protocol === 'blob:') {
+		try {
+			const inner = new URL(u.pathname);
+			return inner.protocol === 'http:' || inner.protocol === 'https:';
+		} catch {
+			return false;
+		}
+	}
+	return false;
+}
+
+// Control characters, and the invisible and direction characters that can disguise an extension ("txt.exe" shown as "exe.txt").
+// eslint-disable-next-line no-control-regex
+const INVISIBLE = /[\u0000-\u001f\u007f-\u009f\u00ad\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff]/g;
+const RESERVED_CHARS = /[<>:"|?*]/g;
+const WINDOWS_RESERVED = /^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\..*)?$/i;
+const MAX_NAME = 200;
+const COMPOUND_EXTENSIONS = ['.tar.gz', '.tar.bz2', '.tar.xz', '.tar.zst', '.tar.lz', '.tar.z'];
+
+/**
+ * A file name that is safe to write in the downloads folder: only the last path segment, no control,
+ * invisible or direction characters, none of <>:"|?*, no leading dots (hidden files) or trailing dots
+ * and spaces, not a Windows device name, and at most 200 characters with the extension kept.
+ */
+export function sanitizeFilename(raw: string, fallback = 'download'): string {
+	let name = String(raw ?? '');
+	name = name.split(/[/\\]/).pop() ?? '';
+	name = name.replace(INVISIBLE, '').replace(RESERVED_CHARS, '_');
+	name = name.trim().replace(/^[.\s]+/, '').replace(/[.\s]+$/, '');
+	if (!name) {
+		return fallback;
+	}
+	if (WINDOWS_RESERVED.test(name)) {
+		name = `_${name}`;
+	}
+	if (name.length > MAX_NAME) {
+		const { stem, ext } = splitExtension(name);
+		const keep = ext.length <= 16 ? ext : '';
+		name = stem.slice(0, MAX_NAME - keep.length).replace(/[.\s]+$/, '') + keep;
+	}
+	return name;
+}
+
+/** "archive.tar.gz" → { stem: "archive", ext: ".tar.gz" }; "README" → { stem: "README", ext: "" }. */
+export function splitExtension(name: string): { stem: string; ext: string } {
+	const lower = name.toLowerCase();
+	for (const ext of COMPOUND_EXTENSIONS) {
+		if (lower.endsWith(ext) && lower.length > ext.length) {
+			return { stem: name.slice(0, -ext.length), ext: name.slice(-ext.length) };
+		}
+	}
+	const dot = name.lastIndexOf('.');
+	return dot > 0 ? { stem: name.slice(0, dot), ext: name.slice(dot) } : { stem: name, ext: '' };
+}
+
+/** `name`, or "name (1).ext", "name (2).ext"…: the first that `taken` says is free. Never overwrites. */
+export function uniqueFilename(name: string, taken: (candidate: string) => boolean): string {
+	if (!taken(name)) {
+		return name;
+	}
+	const { stem, ext } = splitExtension(name);
+	for (let n = 1; n < 10_000; n++) {
+		const candidate = `${stem} (${n})${ext}`;
+		if (!taken(candidate)) {
+			return candidate;
+		}
+	}
+	throw new Error(`No free name for ${name}`);
+}
+
+/**
+ * Files that run something when opened: apps, installers, scripts, shortcuts. The downloads list
+ * never opens these; it shows them in the folder instead, so running one is the user's own act.
+ */
+const EXECUTABLE_EXTENSIONS = new Set([
+	'app', 'command', 'tool', 'terminal', 'workflow', 'action', 'scpt', 'applescript', 'pkg', 'mpkg', 'dmg', 'iso', 'img',
+	'sh', 'bash', 'zsh', 'csh', 'ksh', 'fish', 'py', 'pyw', 'pl', 'rb', 'php', 'js', 'jse', 'mjs', 'cjs', 'vbs', 'vbe', 'wsf', 'wsh', 'ps1', 'psm1', 'psd1',
+	'exe', 'msi', 'msix', 'msixbundle', 'appx', 'appxbundle', 'bat', 'cmd', 'com', 'scr', 'cpl', 'msc', 'hta', 'lnk', 'url', 'reg', 'inf', 'pif', 'jar', 'appref-ms', 'application', 'gadget', 'diagcab', 'settingcontent-ms',
+	'deb', 'rpm', 'appimage', 'run', 'bin', 'desktop', 'flatpakref', 'snap', 'apk', 'xpi', 'crx', 'vsix', 'webloc', 'inetloc', 'fileloc', 'mobileconfig', 'kext', 'plugin', 'prefpane', 'saver', 'qlgenerator',
+]);
+
+export function isExecutableName(name: string): boolean {
+	const dot = name.lastIndexOf('.');
+	return dot >= 0 && EXECUTABLE_EXTENSIONS.has(name.slice(dot + 1).toLowerCase());
+}
+
+/** "~" and "~/x" relative to `home`; anything else unchanged. */
+export function expandHome(path: string, home: string): string {
+	if (path === '~') {
+		return home;
+	}
+	if (path.startsWith('~/') || path.startsWith('~\\')) {
+		return home.replace(/[/\\]+$/, '') + path.slice(1);
+	}
+	return path;
+}
+
+/** 0 B, 512 B, 1.2 KB, 12.4 MB, 1.20 GB (1024-based, like browsers). */
+export function formatBytes(bytes: number): string {
+	if (!Number.isFinite(bytes) || bytes < 1024) {
+		return `${Math.max(0, Math.round(bytes || 0))} B`;
+	}
+	const units = ['KB', 'MB', 'GB', 'TB'];
+	let value = bytes / 1024;
+	let unit = 0;
+	while (value >= 1024 && unit < units.length - 1) {
+		value /= 1024;
+		unit++;
+	}
+	const digits = unit >= 2 ? 2 : 1;
+	return `${value >= 100 ? Math.round(value) : value.toFixed(value >= 10 ? 1 : digits)} ${units[unit]}`;
+}
+
+/** What a download's row says under its name. */
+export function describeDownload(d: Pick<IBrowserDownload, 'state' | 'waitingFor' | 'receivedBytes' | 'totalBytes' | 'bytesPerSecond' | 'error'>): string {
+	const size = d.totalBytes > 0 ? formatBytes(d.totalBytes) : '';
+	switch (d.state) {
+		case 'awaiting':
+			return d.waitingFor === 'large'
+				? `${size} · waiting for your OK`
+				: `${size ? `${size} · ` : ''}${d.waitingFor === 'page' ? 'the page' : 'an agent'} started it · waiting for your OK`;
+		case 'progressing': {
+			const done = d.totalBytes > 0 ? `${formatBytes(d.receivedBytes)} of ${size}` : formatBytes(d.receivedBytes);
+			if (d.bytesPerSecond <= 0) {
+				return done;
+			}
+			const left = d.totalBytes > d.receivedBytes ? Math.ceil((d.totalBytes - d.receivedBytes) / d.bytesPerSecond) : 0;
+			return `${done} · ${formatBytes(d.bytesPerSecond)}/s${left > 0 ? ` · ${formatDuration(left)} left` : ''}`;
+		}
+		case 'completed':
+			return formatBytes(d.receivedBytes || d.totalBytes);
+		case 'cancelled':
+			return 'Cancelled';
+		case 'failed':
+			return d.error ? `Failed · ${d.error}` : 'Failed';
+	}
+}
+
+function formatDuration(seconds: number): string {
+	if (seconds < 60) {
+		return `${seconds} s`;
+	}
+	if (seconds < 3600) {
+		return `${Math.round(seconds / 60)} min`;
+	}
+	return `${Math.floor(seconds / 3600)} h ${Math.round((seconds % 3600) / 60)} min`;
+}
+
+/** The fraction done, 0..1, or undefined when the size is unknown. */
+export function downloadProgress(d: Pick<IBrowserDownload, 'receivedBytes' | 'totalBytes' | 'state'>): number | undefined {
+	if (d.state === 'completed') {
+		return 1;
+	}
+	return d.totalBytes > 0 ? Math.min(1, d.receivedBytes / d.totalBytes) : undefined;
+}
+
+/** The newest `max` downloads, but never dropping one that is still active. */
+export function pruneDownloads<T extends Pick<IBrowserDownload, 'state'>>(list: readonly T[], max = MAX_DOWNLOADS_KEPT): T[] {
+	const out = [...list];
+	for (let i = 0; out.length > max && i < out.length;) {
+		if (isDownloadFinished(out[i].state)) {
+			out.splice(i, 1);
+		} else {
+			i++;
+		}
+	}
+	return out;
+}
+
+/** The longest an agent's browser call can hold its scope; one never ended (a crashed extension) is dropped then. */
+export const MAX_AGENT_SCOPE_MS = 15 * 60_000;
+
+/** Input that gives a page user activation (as the browser view's popup blocker counts it); a mouse move doesn't. */
+const ACTIVATING_INPUT = new Set(['rawKeyDown', 'keyDown', 'mouseDown', 'pointerDown', 'pointerUp', 'touchEnd']);
+
+/**
+ * Whose a download is. Agents' browser calls each hold a token (begin … end); a download that starts
+ * while calls act belongs to the newest of them, and only that call takes the OK in its chat. After an
+ * agent acted, every page stays the agent's until the user interacts with it (input while an agent acts
+ * doesn't count: CDP's clicks are input too). A download is the user's only when it has a user gesture
+ * and the user interacted with that page since an agent last acted; one without a gesture is the page's.
+ */
+export class DownloadAttribution<Page extends object = object> {
+	private readonly calls = new Map<string, number>();
+	private seq = 0;
+	/** Orders agent acts and user input; times can tie. */
+	private tick = 0;
+	/** The tick an agent last acted at: a call began, ended or was dropped. */
+	private agentAt = 0;
+	/** Each page's tick of the user's last activating input there. */
+	private readonly userAt = new WeakMap<Page, number>();
+
+	constructor(private readonly now: () => number = Date.now, private readonly maxScopeMs = MAX_AGENT_SCOPE_MS) { }
+
+	begin(): string {
+		this.prune();
+		const token = `agent-call-${++this.seq}-${this.now().toString(36)}`;
+		this.calls.set(token, this.now());
+		this.agentAt = ++this.tick;
+		return token;
+	}
+
+	/** Ends one call; the others keep acting. An unknown or ended token changes nothing. */
+	end(token: string): void {
+		if (this.calls.delete(token)) {
+			this.agentAt = ++this.tick;
+		}
+	}
+
+	/** Electron's input-event `type` on a browser view's page. */
+	userInput(page: Page, type: string): void {
+		this.prune();
+		if (ACTIVATING_INPUT.has(type) && this.calls.size === 0) {
+			this.userAt.set(page, ++this.tick);
+		}
+	}
+
+	classify(page: Page | undefined, hasUserGesture: boolean): { byAgent: boolean; agentCall?: string; waitingFor?: 'agent' | 'page' } {
+		this.prune();
+		const agentCall = [...this.calls.keys()].at(-1);
+		if (agentCall) {
+			return { byAgent: true, agentCall, waitingFor: 'agent' };
+		}
+		if ((page ? this.userAt.get(page) ?? 0 : 0) < this.agentAt) {
+			return { byAgent: true, waitingFor: 'agent' };
+		}
+		return hasUserGesture ? { byAgent: false } : { byAgent: false, waitingFor: 'page' };
+	}
+
+	private prune(): void {
+		for (const [token, began] of this.calls) {
+			if (this.now() - began > this.maxScopeMs) {
+				this.calls.delete(token);
+				this.agentAt = ++this.tick;
+			}
+		}
+	}
+}
