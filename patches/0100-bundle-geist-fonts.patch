+.monaco-workbench.windows { font-family: "Geist", "Segoe WPC", "Segoe UI", sans-serif; }
+.monaco-workbench.windows:lang(zh-Hans) { font-family: "Geist", "Segoe WPC", "Segoe UI", "Microsoft YaHei", sans-serif; }
