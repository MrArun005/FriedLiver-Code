--- /dev/null
+++ b/src/vs/platform/list/browser/listDensity.ts
@@ -0,0 +1,19 @@
+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver: tree row density (COMPONENTS.md §2.19, §6.3). Comfortable rows are 24 tall (WCAG 2.5.8
+ *  target size), compact rows 22 (upstream's height). Read by the Explorer, Source Control, Outline and
+ *  Search delegates; listService.ts updates it from `workbench.list.density` whenever a workbench tree
+ *  is created, so a change applies to views opened afterwards (and to every view after a reload).
+ *--------------------------------------------------------------------------------------------*/
+
+export const LIST_DENSITY_SETTING = 'workbench.list.density';
+
+let rowHeight = 24;
+
+/** The height of one tree row at the current density. */
+export function listRowHeight(): number {
+	return rowHeight;
+}
+
+export function setListDensity(value: unknown): void {
+	rowHeight = value === 'compact' ? 22 : 24;
+}
