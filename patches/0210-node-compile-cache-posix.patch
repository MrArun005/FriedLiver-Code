+/**
+ * FriedLiver: upstream's packaged cache is portable and read-only (generated at build time), which
+ * is what the TODO above says is broken on POSIX. This is the plain form instead: writable, not
+ * portable, not eager, in the user data folder (`FRIEDLIVER_NODE_COMPILE_CACHE`, set by mainImpl and
+ * inherited by the utility processes). Node checks each entry against the module's source and its
+ * own version, and the folder is per product commit. Off when that variable is missing (first
+ * process: main; argv.json `"node-compile-cache": false`; no commit) or NODE_DISABLE_COMPILE_CACHE=1.
+ */
+function enableWritableNodeCompileCache(kind: NodeCompileCacheKind, packagedDirectory: string): false {
+	const root = process.env['FRIEDLIVER_NODE_COMPILE_CACHE'];
+	if (!root) {
+		setNodeCompileCacheStatus({ kind, status: 'disabled', configuredDirectory: packagedDirectory, isPackagedCacheEnabled: false });
+		return false;
+	}
+
+	const directory = join(root, kind);
+	const result = enableCompileCache({ directory });
+	const status = result.status === constants.compileCacheStatus.ENABLED ? 'enabled'
+		: result.status === constants.compileCacheStatus.ALREADY_ENABLED ? 'already-enabled'
+			: result.status === constants.compileCacheStatus.DISABLED ? 'disabled'
+				: 'failed';
+	setNodeCompileCacheStatus({
+		kind,
+		status,
+		configuredDirectory: directory,
+		activeDirectory: getCompileCacheDir() ?? result.directory,
+		isPackagedCacheEnabled: false,
+		message: result.message
+	});
+
+	// Node writes the cache only when the process exits normally; utility processes are often
+	// killed at shutdown, so write what startup compiled once it is over.
+	if (status === 'enabled') {
+		// src's typings make timers a TimeoutHandle; at runtime this is Node's Timeout.
+		(setNodeTimeout(() => flushCompileCache(), 20_000) as unknown as { unref(): void }).unref();
+	}
+	return false;
+}
