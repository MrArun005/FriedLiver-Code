+/*---------------------------------------------------------------------------------------------
+ *  FriedLiver (patch 0310): the companion's rules, kept free of imports so tests can run them.
+ *  What an item from the Agents extension may hold, and the queue: one shown, the rest counted,
+ *  the next one up when it is answered, hidden or put off for later.
+ *--------------------------------------------------------------------------------------------*/
+
+export type CompanionChoiceKind = 'primary' | 'secondary' | 'danger';
+
+export interface ICompanionChoice {
+	readonly id: string;
+	readonly label: string;
+	readonly kind: CompanionChoiceKind;
+}
+
+/** A video character. Its bytes come once (the first ask that uses it); later asks name it by key. */
+export interface ICompanionVideo {
+	/** The file's path, size and time: a changed file is a new key. */
+	readonly key: string;
+	readonly type: CompanionVideoType;
+	readonly bytes?: Uint8Array;
+}
+
+export type CompanionVideoType = 'video/webm' | 'video/mp4' | 'video/quicktime';
+const VIDEO_TYPES: readonly string[] = ['video/webm', 'video/mp4', 'video/quicktime'];
+export const MAX_VIDEO_BYTES = 20 * 1024 * 1024;
+
+export interface ICompanionItem {
+	readonly id: string;
+	readonly chatId: string;
+	readonly agentLabel: string;
+	readonly chatTitle: string;
+	readonly question: string;
+	readonly detail?: string;
+	readonly choices: readonly ICompanionChoice[];
+	/** A data: image URI, or '' for none. */
+	readonly character: string;
+	readonly characterRun?: string;
+	/** A video for the character standing (and the run, when there is no run video); the pictures are its fallback. */
+	readonly video?: ICompanionVideo;
+	readonly videoRun?: ICompanionVideo;
+}
+
+const MAX_TEXT = 2_000;
+const MAX_DETAIL = 20_000;
+const MAX_CHOICES = 12;
+/** Only inline pictures: the workbench never loads a file or address an item names. */
+const IMAGE = /^data:image\/(?:svg\+xml|png|gif|webp);base64,[A-Za-z0-9+/]+=*$/;
+
+const text = (v: unknown, max = MAX_TEXT): string | undefined => typeof v === 'string' && v.length <= max ? v : undefined;
+const id = (v: unknown): string | undefined => typeof v === 'string' && v.length > 0 && v.length <= 200 ? v : undefined;
+
+export function isCompanionImage(v: unknown): v is string {
+	return typeof v === 'string' && IMAGE.test(v);
+}
+
+/** Bytes as sent: a Uint8Array, or a VSBuffer (which holds one in `buffer`) after the extension host's IPC. */
+function bytesOf(v: unknown): Uint8Array | undefined {
+	const b = v instanceof Uint8Array ? v : v && typeof v === 'object' && (v as { buffer?: unknown }).buffer instanceof Uint8Array ? (v as { buffer: Uint8Array }).buffer : undefined;
+	return b && b.byteLength > 0 && b.byteLength <= MAX_VIDEO_BYTES ? b : undefined;
+}
+
+/** A video reference, null when present but malformed (the whole item is refused), undefined when absent. */
+export function parseCompanionVideo(raw: unknown): ICompanionVideo | undefined | null {
+	if (raw === undefined) {
+		return undefined;
+	}
+	const r = raw && typeof raw === 'object' ? raw as Record<string, unknown> : undefined;
+	const key = id(r?.key), type = r?.type;
+	if (!key || typeof type !== 'string' || !VIDEO_TYPES.includes(type)) {
+		return null;
+	}
+	if (r!.bytes === undefined) {
+		return { key, type: type as CompanionVideoType };
+	}
+	const bytes = bytesOf(r!.bytes);
+	return bytes ? { key, type: type as CompanionVideoType, bytes } : null;
+}
+
+/** The item, or undefined when anything in it is not what the companion shows. */
+export function parseCompanionItem(raw: unknown): ICompanionItem | undefined {
+	if (!raw || typeof raw !== 'object') {
+		return undefined;
+	}
+	const r = raw as Record<string, unknown>;
+	const itemId = id(r.id), chatId = id(r.chatId), agentLabel = text(r.agentLabel), chatTitle = text(r.chatTitle), question = text(r.question);
+	if (!itemId || !chatId || agentLabel === undefined || chatTitle === undefined || !question || !Array.isArray(r.choices) || r.choices.length > MAX_CHOICES) {
+		return undefined;
+	}
+	const choices: ICompanionChoice[] = [];
+	for (const c of r.choices as unknown[]) {
+		const o = c && typeof c === 'object' ? c as Record<string, unknown> : undefined;
+		const cid = id(o?.id), label = text(o?.label, 200), kind = o?.kind;
+		if (!cid || !label || (kind !== 'primary' && kind !== 'secondary' && kind !== 'danger') || choices.some(x => x.id === cid)) {
+			return undefined;
+		}
+		choices.push({ id: cid, label, kind });
+	}
+	const detail = r.detail === undefined ? undefined : text(r.detail, MAX_DETAIL);
+	if (r.detail !== undefined && detail === undefined) {
+		return undefined;
+	}
+	const character = r.character === '' || isCompanionImage(r.character) ? r.character as string : undefined;
+	if (character === undefined) {
+		return undefined;
+	}
+	const characterRun = isCompanionImage(r.characterRun) ? r.characterRun : undefined;
+	const video = parseCompanionVideo(r.video), videoRun = parseCompanionVideo(r.videoRun);
+	if (video === null || videoRun === null) {
+		return undefined;
+	}
+	return { id: itemId, chatId, agentLabel, chatTitle, question, ...(detail ? { detail } : {}), choices, character, ...(characterRun ? { characterRun } : {}), ...(video ? { video } : {}), ...(videoRun ? { videoRun } : {}) };
+}
+
+/**
+ * What the character shows in each phase, best first: on the run, the run video, the corner video,
+ * the run picture, the picture; in the corner, the video, then the picture. A video that failed or
+ * never arrived is passed over (`playable`), so the agent's built-in picture stands in.
+ */
+export function characterSources(item: ICompanionItem, phase: 'run' | 'idle', playable: (v: ICompanionVideo) => boolean): ({ video: ICompanionVideo } | { image: string })[] {
+	const videos = (phase === 'run' ? [item.videoRun, item.video] : [item.video]).filter((v): v is ICompanionVideo => !!v && playable(v));
+	const images = (phase === 'run' ? [item.characterRun, item.character] : [item.character]).filter((i): i is string => !!i);
+	return [...videos.map(video => ({ video })), ...images.map(image => ({ image }))];
+}
+
+/** Waiting items in arrival order. The first is the one shown; the others are the "+N". */
+export class CompanionQueue {
+	private readonly _items = new Map<string, ICompanionItem>();
+	/** Put off with Esc: not shown again (they still wait in their chat and the Inbox). */
+	private readonly _later = new Set<string>();
+
+	get current(): ICompanionItem | undefined {
+		return this._items.values().next().value;
+	}
+
+	/** How many wait behind the one shown. */
+	get more(): number {
+		return Math.max(0, this._items.size - 1);
+	}
+
+	/** Adds an item; an id already queued or put off keeps its place and is not replaced. */
+	show(item: ICompanionItem): boolean {
+		if (this._items.has(item.id) || this._later.has(item.id)) {
+			return false;
+		}
+		this._items.set(item.id, item);
+		return true;
+	}
+
+	/** Removes it (answered, here or elsewhere). True when it was the one shown. */
+	hide(itemId: string): boolean {
+		const wasCurrent = this.current?.id === itemId;
+		this._items.delete(itemId);
+		this._later.delete(itemId);
+		return wasCurrent;
+	}
+
+	/** Esc: the shown item goes away without an answer. */
+	later(): void {
+		const c = this.current;
+		if (c) {
+			this._items.delete(c.id);
+			this._later.add(c.id);
+		}
+	}
+
+	/** Whether a click on (itemId, choiceId) is one the shown item offers. */
+	offers(itemId: string, choiceId: string): boolean {
+		const c = this.current;
+		return !!c && c.id === itemId && c.choices.some(x => x.id === choiceId);
+	}
+}
+
+// ---- How a character sits in the corner, decided once per clip or picture from its first frames ----
+
+/** RGBA pixels, as a canvas's getImageData gives them. */
+export interface ICompanionFrame {
+	readonly data: Uint8ClampedArray;
+	readonly width: number;
+	readonly height: number;
+}
+
+/**
+ * - alpha: it has real transparency at its edges (VP9-alpha webm, a cut-out GIF/WebP/SVG): it floats.
+ * - key: opaque, but its border is one flat colour (a green screen, a plain wall): that colour is keyed out and it floats.
+ * - frame: anything else (a busy background): it sits in the rounded portal.
+ */
+export type CompanionFrameVerdict = { readonly kind: 'alpha' } | { readonly kind: 'key'; readonly color: readonly [number, number, number] } | { readonly kind: 'frame' };
+
+/** The pixels on a frame's outer ring (one pixel in from the edge, so a stray encoder border doesn't count). */
+function ring(f: ICompanionFrame): number[] {
+	const out: number[] = [];
+	const inset = f.width > 4 && f.height > 4 ? 1 : 0;
+	const x0 = inset, y0 = inset, x1 = f.width - 1 - inset, y1 = f.height - 1 - inset;
+	const at = (x: number, y: number) => out.push((y * f.width + x) * 4);
+	for (let x = x0; x <= x1; x++) {
+		at(x, y0);
+		at(x, y1);
+	}
+	for (let y = y0 + 1; y < y1; y++) {
+		at(x0, y);
+		at(x1, y);
+	}
+	return out;
+}
+
+/** Edge alpha below this is transparent. */
+const CLEAR_ALPHA = 16;
+/** A border pixel this close (RGB distance) to the border's mean colour counts as that colour. */
+const FLAT_DISTANCE = 40;
+
+export function frameVerdict(frames: readonly ICompanionFrame[]): CompanionFrameVerdict {
+	const usable = frames.filter(f => f.width > 0 && f.height > 0 && f.data.length >= f.width * f.height * 4);
+	if (!usable.length) {
+		return { kind: 'frame' };
+	}
+	const first = usable[0];
+	const edge = ring(first);
+	if (edge.filter(i => first.data[i + 3] < CLEAR_ALPHA).length >= edge.length / 2) {
+		return { kind: 'alpha' };
+	}
+	const samples: [number, number, number][] = [];
+	for (const f of usable) {
+		for (const i of ring(f)) {
+			samples.push([f.data[i], f.data[i + 1], f.data[i + 2]]);
+		}
+	}
+	const mean = [0, 1, 2].map(c => samples.reduce((a, s) => a + s[c], 0) / samples.length) as [number, number, number];
+	const near = samples.filter(s => Math.hypot(s[0] - mean[0], s[1] - mean[1], s[2] - mean[2]) <= FLAT_DISTANCE).length;
+	return near >= samples.length * 0.9 ? { kind: 'key', color: [Math.round(mean[0]), Math.round(mean[1]), Math.round(mean[2])] } : { kind: 'frame' };
+}
+
+/** Keys `color` out of RGBA pixels in place: soft edges between `inner` and `outer` (RGB distance), spill pulled back there. */
+export function chromaKey(data: Uint8ClampedArray, color: readonly [number, number, number], inner = 48, outer = 110): void {
+	const [kr, kg, kb] = color;
+	// Spill suppression only for a coloured screen: on a grey wall there is no one channel to pull back.
+	const dominant = Math.max(kr, kg, kb) - Math.min(kr, kg, kb) > 60 ? [kr, kg, kb].indexOf(Math.max(kr, kg, kb)) : -1;
+	for (let i = 0; i < data.length; i += 4) {
+		const d = Math.hypot(data[i] - kr, data[i + 1] - kg, data[i + 2] - kb);
+		const a = d <= inner ? 0 : d >= outer ? 1 : (d - inner) / (outer - inner);
+		data[i + 3] = Math.round(data[i + 3] * a);
+		// The soft edge is where the screen's colour bleeds in: its dominant channel goes no higher than the others.
+		if (dominant >= 0 && a > 0 && a < 1) {
+			const others = [0, 1, 2].filter(c => c !== dominant).map(c => data[i + c]);
+			data[i + dominant] = Math.min(data[i + dominant], Math.max(others[0], others[1]));
+		}
+	}
+}
