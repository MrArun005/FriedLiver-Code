new file mode 100644
index 00000000..7f05b18e
--- /dev/null
+++ b/src/vs/platform/extensionManagement/node/openVsxSignature.ts
@@ -0,0 +1,48 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) FriedLiver. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// FriedLiver: checks Open VSX registry signatures. Microsoft's verifier (@vscode/vsce-sign) may only be
+// used with Microsoft's products, so forks can't ship it. Open VSX signs the raw .vsix bytes with one
+// Ed25519 key per registry and serves the 64-byte signature as `.signature.sig` in the .sigzip
+// (eclipse-openvsx/openvsx ExtensionVersionIntegrityService). The `.signature.manifest` beside it isn't
+// signed, so it's not read; the empty `.signature.p7s` is only there for VS Code's zip check.
+// Kept free of VS Code imports so the fork's own tests can run it.
+
+import { createPublicKey, verify } from 'crypto';
+
+/**
+ * Registry keys, pinned: never fetched. Keyed by the id in the gallery's
+ * Microsoft.VisualStudio.Services.PublicKey asset; values are SPKI DER, base64.
+ */
+export const OPEN_VSX_PUBLIC_KEYS: Readonly<Record<string, string>> = {
+	// open-vsx.org, https://open-vsx.org/api/-/public-key/14ccb407-4e79-41ed-be5a-6d608325c45a (checked 2026-10-19)
+	'14ccb407-4e79-41ed-be5a-6d608325c45a': 'MCowBQYDK2VwAyEAje+vAaSS1zHV5WHCJSa5UXvxRo6+yerEU3IEmtuEuF4=',
+};
+
+/** The key id at the end of a PublicKey asset URL (`.../api/-/public-key/<id>`). */
+export function openVsxPublicKeyId(uri: string | undefined): string | undefined {
+	return uri ? /\/public-key\/([0-9a-f-]{1,64})\/?$/i.exec(uri)?.[1]?.toLowerCase() : undefined;
+}
+
+/**
+ * valid: one of the pinned keys signed exactly these bytes.
+ * invalid: the gallery names a pinned key, but the signature is missing, malformed or doesn't match.
+ * unknownKey: no pinned key matches and the gallery names none of them (another registry, or a key
+ * FriedLiver doesn't know yet), so nothing can be said either way.
+ */
+export function verifyOpenVsxSignature(vsix: Uint8Array, signature: Uint8Array | undefined, keyId: string | undefined, keys: Readonly<Record<string, string>> = OPEN_VSX_PUBLIC_KEYS): 'valid' | 'invalid' | 'unknownKey' {
+	if (signature?.length === 64) {
+		for (const der of Object.values(keys)) {
+			const key = createPublicKey({ key: Buffer.from(der, 'base64'), format: 'der', type: 'spki' });
+			try {
+				if (verify(null, vsix, key, signature)) {
+					return 'valid';
+				}
+			} catch {
+				// A malformed signature is a failed check, never a reason to skip it.
+			}
+		}
+	}
+	return keyId !== undefined && Object.prototype.hasOwnProperty.call(keys, keyId) ? 'invalid' : 'unknownKey';
+}
