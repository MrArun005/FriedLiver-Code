+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) FriedLiver. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+// FriedLiver: what happens to a gallery extension once its signature has been checked
+// (node/openVsxSignature.ts). Kept free of imports so the fork's own tests can run it.
+
+/** Extension ids you chose to install although their signature couldn't be checked. Application scope. */
+export const AllowUnsignedExtensionsConfigKey = 'extensions.allowUnsigned';
+
+/** Install-options context flag set by "Install Anyway", for that one install. */
+export const ALLOW_UNSIGNED_CONTEXT = 'friedliver.allowUnsigned';
+
+// Results that say the package isn't what the registry signed. Never installed, whatever was allowed.
+const TAMPERED = new Set([
+	'SignatureIsNotValid', 'SignatureIsInvalid', 'SignatureManifestIsInvalid', 'SignatureIntegrityCheckFailed',
+	'PackageIntegrityCheckFailed', 'EntryIsMissing', 'EntryIsTampered', 'CertificateRevoked',
+]);
+
+export type SignatureDecision = 'install' | 'ask' | 'refuse';
+
+/**
+ * @param status the check's ExtensionSignatureVerificationCode, or undefined when the check couldn't run.
+ * @param required the marketplace's manifest says all its extensions are signed.
+ * @param allowed you answered "Install Anyway" for this extension.
+ */
+export function decideSignature(status: string | undefined, required: boolean, allowed: boolean): SignatureDecision {
+	if (status === 'Success') {
+		return 'install';
+	}
+	if ((status !== undefined && TAMPERED.has(status)) || required) {
+		return 'refuse';
+	}
+	// Not signed, signed with a key FriedLiver doesn't know, or the check couldn't run.
+	return allowed ? 'install' : 'ask';
+}
+
+export function isUnsignedAllowed(setting: unknown, extensionId: string): boolean {
+	const id = extensionId.toLowerCase();
+	return Array.isArray(setting) && setting.some(entry => typeof entry === 'string' && entry.toLowerCase() === id);
+}
